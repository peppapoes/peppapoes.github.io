---
/**
 * An invitation to Femke's social media with a button per account: side by side
 * (the sentence left, the buttons right), or with `centered` stacked in the middle.
 */
interface Props {
	centered?: boolean;
}

const { centered = false } = Astro.props;

const socials = [
	{ label: 'Instagram', href: 'https://www.instagram.com/fdsgns/' },
	{ label: 'Behance', href: 'https://www.behance.net/femkedelatter' },
];
---

<div class:list={['invite', { 'invite--centered': centered }]}>
	<p class="invite__text">Can’t get enough? My social media accounts are full of it too!</p>
	<ul class="invite__buttons">
		{socials.map(({ label, href }) => (
			<li><a class="invite__button" href={href} target="_blank" rel="noopener noreferrer">{label}</a></li>
		))}
	</ul>
</div>

<style>
	.invite {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem 2rem;
	}

	.invite--centered {
		flex-direction: column;
		justify-content: center;
		gap: clamp(1.5rem, 2.6vw, 2.5rem);
		text-align: center;
	}

	.invite__text {
		margin: 0;
		font-family: var(--font-hand);
		font-size: var(--text-subtitle);
		letter-spacing: 0.02em;
	}

	.invite__buttons {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: clamp(0.75rem, 1.7vw, 1.6rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.invite__button {
		display: grid;
		place-items: center;
		min-width: clamp(9rem, 17vw, 16rem);
		padding: 0.85em 1.5em 0.75em;
		border: 1.5px solid var(--color-fg);
		font-size: clamp(1rem, 1.6vw, 1.5rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		text-decoration: none;
		text-transform: uppercase;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}

	.invite__button:hover,
	.invite__button:focus-visible {
		border-color: var(--color-accent);
		background: var(--color-accent);
		color: var(--color-bg);
		outline: none;
	}

	@media (max-width: 800px) {
		.invite__buttons,
		.invite__buttons li {
			flex: 1 1 auto;
		}

		.invite--centered .invite__buttons {
			align-self: stretch;
		}

		.invite__button {
			min-width: 0;
		}
	}
</style>
