---
import StrokeStar from '../assets/icons/stroke-star.svg';
import StrokeStarAlt from '../assets/icons/stroke-star2.svg';
import FullStar from '../assets/icons/full-star.svg';

const variants = {
	outline: StrokeStar,
	'outline-alt': StrokeStarAlt,
	filled: FullStar,
};

interface Props {
	variant?: keyof typeof variants;
	size?: string;
	class?: string;
	style?: string;
}

const { variant = 'outline', size = '2rem', class: className, style } = Astro.props;
const Icon = variants[variant];
---

<Icon class:list={['star', className]} style={`--star-size: ${size}; ${style ?? ''}`} aria-hidden="true" />

<style>
	.star {
		width: var(--star-size);
		height: auto;
		color: var(--color-fg);
		pointer-events: none;
	}
</style>
