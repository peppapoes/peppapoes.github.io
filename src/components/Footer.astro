---
import SocialLinks from './SocialLinks.astro';

const email = 'fdelatter@gmail.com';
---

<footer id="contact" class="footer">
	<svg class="footer__splash" viewBox="0 0 1000 170" preserveAspectRatio="none" aria-hidden="true">
		<defs>
			<filter id="rough-edge">
				<feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="4" />
				<feDisplacementMap in="SourceGraphic" scale="7" />
			</filter>
		</defs>
		<path
			filter="url(#rough-edge)"
			d="M405 4 L452 58 L520 70 L585 76 L622 14 L640 88 L760 62 L880 38 L1000 6 L1000 175 L470 175 Z"
		/>
	</svg>

	<p class="footer__logo" aria-hidden="true">FDSGNS</p>

	<div class="footer__contact">
		<SocialLinks />
		<p>
			Interested in my work or have any questions?<br />
			<a href={`mailto:${email}`}>Contact me: {email}</a>
		</p>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		height: 17vw;
		min-height: 11rem;
		overflow: hidden;
	}

	.footer__splash {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		fill: var(--color-accent);
	}

	.footer__logo {
		position: relative;
		margin: 0 0 -0.1em calc(var(--gutter) - 0.04em);
		font-size: 12.5vw;
		font-weight: 700;
		line-height: 0.8;
		letter-spacing: -0.02em;
	}

	.footer__contact {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 1rem;
		padding: 0 var(--gutter) 1.5rem;
		text-align: right;
	}

	.footer__contact p {
		margin: 0;
		font-size: clamp(0.8rem, 1.1vw, 1rem);
		line-height: 1.5;
		letter-spacing: -0.02em;
	}

	.footer__contact a:hover {
		color: var(--color-bg);
	}

	@media (max-width: 640px) {
		.footer {
			flex-direction: column-reverse;
			align-items: stretch;
			height: auto;
			padding-top: 3rem;
		}

		.footer__logo {
			font-size: 22vw;
		}

		.footer__contact {
			align-items: flex-start;
			text-align: left;
			padding-bottom: 0;
		}
	}
</style>
