---
import SocialLinks from './SocialLinks.astro';
import FooterStar from '../assets/images/footer_star.svg';

const email = 'fdelatter@gmail.com';
---

<footer id="contact" class="footer">
	<FooterStar class="footer__splash" aria-hidden="true" />

	<p class="footer__logo" aria-hidden="true">FDSGNS</p>

	<div class="footer__contact">
		<SocialLinks />
		<p>
			Interested in my work or have any questions?<br />
			<a href={`mailto:${email}`}>Contact me: {email}</a>
		</p>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		min-height: 17vw;
		padding-bottom: clamp(1rem, 1.6vw, 1.75rem);
		overflow: hidden;
	}

	/* Keeps its own aspect ratio and grows from the bottom-right corner. */
	.footer__splash {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 76%;
		height: auto;
	}

	.footer__logo {
		position: relative;
		margin: 0 0 0 calc(var(--gutter) - 0.04em);
		font-size: 12.5vw;
		font-weight: 700;
		line-height: 0.8;
		letter-spacing: -0.02em;
	}

	.footer__contact {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 1rem;
		padding: 0 var(--gutter);
		text-align: right;
	}

	.footer__contact p {
		margin: 0;
		font-size: clamp(0.8rem, 1.1vw, 1rem);
		line-height: 1.5;
		letter-spacing: -0.02em;
	}

	.footer__contact a:hover {
		color: var(--color-bg);
	}

	@media (max-width: 640px) {
		.footer {
			flex-direction: column-reverse;
			align-items: stretch;
			padding-top: 3rem;
		}

		.footer__splash {
			width: 160%;
		}

		.footer__logo {
			font-size: 22vw;
		}

		.footer__contact {
			align-items: flex-start;
			text-align: left;
			padding-bottom: 0;
		}
	}
</style>
