---
import SelectionFrame from '../SelectionFrame.astro';
import SelectionTag from '../SelectionTag.astro';
import Star from '../Star.astro';
import ProjectPreview from './ProjectPreview.astro';
import IntroCard from './IntroCard.astro';
import Starfield from '../Starfield.astro';
import { featuredProject, projectUrl, type Category } from '../../data/projects';

// Positions are percentages of the hero area, taken from the Figma design.
// `depth` sets how far an element drifts with the mouse: higher feels closer.
// A tag opens either its category's project preview or, for `intro`, the pink intro card.
// On phones the tags stack in a zigzag instead (`phone`): the order, how far in
// from the left (% of the width) and the space above each one, from the mobile design.
type Phone = { order: number; x: number; gap: number };
const tags: { label: string; x: number; y: number; depth: number; phone: Phone; category?: Category; intro?: boolean }[] = [
	{ label: 'Visual Design', x: 19, y: 22, depth: 14, phone: { order: 1, x: 15, gap: 0 }, category: 'visual-design' },
	{ label: 'My portfolio', x: 71.5, y: 20, depth: 10, phone: { order: 2, x: 63, gap: 1.5 }, intro: true },
	{ label: 'Integration of all courses', x: 52, y: 43, depth: 18, phone: { order: 5, x: 38, gap: 5.5 }, category: 'integration' },
	{ label: 'Motion Design', x: 76.5, y: 67, depth: 12, phone: { order: 3, x: 37, gap: 2.5 }, category: 'motion-design' },
	{ label: 'Coding & Development', x: 9, y: 75, depth: 16, phone: { order: 4, x: 10, gap: 5.3 }, category: 'coding' },
];

// On phones the stars get their own spot (`phone`: % from the left, rem from the top).
// During the intro they gather around Femke's name (`intro`, in % of the hero).
const stars = [
	{ x: 47.5, y: 15, size: '2.6vw', variant: 'outline', depth: 30, phone: { x: 91, y: 3.8 }, intro: { x: 48, y: 22 } },
	{ x: 92.5, y: 26, size: '3.2vw', variant: 'filled', depth: 40, phone: { x: 27, y: 10.1 }, intro: { x: 71, y: 35 } },
	{ x: 34.5, y: 48, size: '1.6vw', variant: 'filled', depth: 24, phone: { x: 82, y: 21.6 }, intro: { x: 29, y: 61 } },
	{ x: 5, y: 57, size: '2.4vw', variant: 'outline-alt', depth: 34, phone: { x: 11, y: 26.6 }, intro: { x: 25, y: 33 } },
	{ x: 62, y: 85, size: '2.4vw', variant: 'outline', depth: 28, phone: { x: 52, y: 36.3 }, intro: { x: 63, y: 71 } },
] as const;

/** Inline custom properties for one floating element; `i` staggers the bobbing and, after the intro, the appearing. */
const floatStyle = (x: number, y: number, depth: number, i: number) =>
	`left: ${x}%; top: ${y}%; --x: ${x}%; --y: ${y}%; --depth: ${depth}; --bob-duration: ${5 + (i % 3)}s; --bob-delay: -${i * 1.3}s; --appear: ${(0.45 + i * 0.08).toFixed(2)}s`;

// The little "(selected work)" note between the tags.
const note = { x: 32, y: 56, depth: 8, phone: { order: 6, x: 40, gap: 3 } };
const phoneTagStyle = ({ order, x, gap }: Phone) => `--p-order: ${order}; --p-x: ${x}%; --p-gap: ${gap}rem`;
---

<!--
	Intro, once per visit: the stars huddle around Femke's name, then the name slides
	apart to both sides while the stars spread out and the tags appear. Runs before
	the hero is drawn, so the page never shows without it first; a click, key, scroll
	or tap skips it. Not with reduced motion.
-->
<script is:inline>
	(() => {
		const root = document.documentElement;
		try {
			if (sessionStorage.getItem('intro-seen') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			sessionStorage.setItem('intro-seen', '1');
		} catch {
			return;
		}
		root.setAttribute('data-intro', '');
		const skips = ['wheel', 'keydown', 'pointerdown', 'touchstart'];
		const end = () => {
			root.removeAttribute('data-intro');
			skips.forEach((type) => removeEventListener(type, end));
		};
		skips.forEach((type) => addEventListener(type, end, { passive: true }));
		setTimeout(end, 1900);
	})();
</script>

<section class="hero" aria-label="Intro" data-hero>
	<h1 class="visually-hidden">Femke De Latter — design portfolio</h1>

	<Starfield count={170} seed={3} parallax />

	<p class="hero__name" aria-hidden="true">
		<SelectionFrame as="span" accent class="hero__first">FEMKE</SelectionFrame>
		<span class="hero__last">DE LATTER</span>
	</p>

	<div class="float float--note" style={`${floatStyle(note.x, note.y, note.depth, tags.length)}; ${phoneTagStyle(note.phone)}`}>
		<div class="float__inner">
			<p class="hero__note">(selected work)</p>
		</div>
	</div>

	{tags.map(({ label, x, y, depth, phone, category, intro }, i) => {
		const project = category && featuredProject(category);
		const panelClass = ['float__panel', { 'float__panel--end': x > 60 }];
		return (
			<div
				class:list={['float', { 'float--end': x > 40 }]}
				style={`${floatStyle(x, y, depth, i)}; ${phoneTagStyle(phone)}`}
				data-item={project || intro ? '' : undefined}
			>
				<div class="float__inner">
					{project ? (
						<>
							<SelectionTag href={projectUrl(project)}>{label}</SelectionTag>
							<div class:list={panelClass}>
								<ProjectPreview id={`preview-${category}`} heading={label} project={project} end={x > 60} />
							</div>
						</>
					) : intro ? (
						<>
							<SelectionTag accent tabindex="0">{label}</SelectionTag>
							<div class:list={panelClass}>
								<IntroCard heading={label} />
							</div>
						</>
					) : (
						<SelectionTag accent>{label}</SelectionTag>
					)}
				</div>
			</div>
		);
	})}

	{stars.map(({ x, y, size, variant, depth, phone, intro }, i) => (
		<div
			class="float float--star"
			style={`${floatStyle(x, y, depth, i + tags.length)}; --p-x: ${phone.x}%; --p-y: ${phone.y}rem; --intro-x: ${intro.x}%; --intro-y: ${intro.y}%`}
		>
			<div class="float__inner">
				<Star variant={variant} size={`max(${size}, 1rem)`} />
			</div>
		</div>
	))}
</section>

<script>
	const hero = document.querySelector<HTMLElement>('[data-hero]');

	if (hero) {
		const items = [...hero.querySelectorAll<HTMLElement>('[data-item]')];
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let closeTimer: number | undefined;

		// Everything drifts a little with the mouse, closer elements a bit more.
		if (!reducedMotion) {
			hero.addEventListener('pointermove', (e) => {
				if (e.pointerType !== 'mouse') return;
				const r = hero.getBoundingClientRect();
				hero.style.setProperty('--mx', String(((e.clientX - r.left) / r.width - 0.5) * 2));
				hero.style.setProperty('--my', String(((e.clientY - r.top) / r.height - 0.5) * 2));
			});
			hero.addEventListener('pointerleave', () => {
				hero.style.setProperty('--mx', '0');
				hero.style.setProperty('--my', '0');
			});
		}

		// Phones have no hover: tapping a tag opens its card below it (pushing the rest
		// down), tapping it again closes it, and the card itself links to the project.
		const phone = matchMedia('(max-width: 640px)');

		const SCREEN_MARGIN = 24; // keep this much room below an opened card
		const HEADER_SPACE = 96; // and never lift a tag behind the header
		const CLOSE_DURATION = reducedMotion ? 0 : 600; // matches the card's size transition
		const closing = new Map<HTMLElement, number>();

		// Low tags would open their card below the fold: lift the tag and card up
		// together until the whole card is visible.
		const lift = (item: HTMLElement, cardHeight: number) => {
			const top = item.getBoundingClientRect().top; // .float itself isn't lifted, only its inner wrapper
			const overflow = top + cardHeight - (innerHeight - SCREEN_MARGIN);
			const room = top - HEADER_SPACE;
			item.style.setProperty('--lift', `${Math.max(0, Math.min(overflow, room))}px`);
		};

		// While a card is open the other tags step aside, away from it: the nearer the
		// tag, the further it moves, and always far enough to leave a clear gap around
		// the card. null lets them all drift back.
		const floats = [...hero.querySelectorAll<HTMLElement>('.float:not(.float--star)')];
		const PUSH = 40; // px, for a tag right next to the card
		const GAP = 36; // px, the least room between the card and any tag
		const pushOf = (el: HTMLElement, axis: 'x' | 'y') => parseFloat(el.style.getPropertyValue(`--push-${axis}`)) || 0;
		const makeRoom = (item: HTMLElement | null) => {
			const cardEl = item?.querySelector<HTMLElement>('[data-card]');
			// Where the card ends up: its own tag moves back in place and is lifted (see lift()).
			let card = { left: 0, right: 0, top: 0, bottom: 0 };
			if (item && cardEl) {
				const rect = cardEl.getBoundingClientRect();
				const left = rect.left - pushOf(item, 'x');
				const top = item.getBoundingClientRect().top - pushOf(item, 'y') - (parseFloat(item.style.getPropertyValue('--lift')) || 0);
				card = { left, right: left + rect.width, top, bottom: top + rect.height };
			}

			for (const other of floats) {
				let x = 0;
				let y = 0;
				if (cardEl && other !== item && !reducedMotion) {
					// The tag's own spot, without the push it may still have from the previous card.
					const rect = other.getBoundingClientRect();
					const tag = {
						left: rect.left - pushOf(other, 'x'),
						right: rect.right - pushOf(other, 'x'),
						top: rect.top - pushOf(other, 'y'),
						bottom: rect.bottom - pushOf(other, 'y'),
					};
					const dx = (tag.left + tag.right) / 2 - (card.left + card.right) / 2;
					const dy = (tag.top + tag.bottom) / 2 - (card.top + card.bottom) / 2;
					const distance = Math.hypot(dx, dy) || 1;
					const amount = PUSH * Math.max(0.3, 1 - distance / hero.offsetWidth);
					x = (dx / distance) * amount;
					y = (dy / distance) * amount;

					// Still too close? Move further along whichever direction needs the least.
					const gapX = Math.max(card.left - (tag.right + x), tag.left + x - card.right);
					const gapY = Math.max(card.top - (tag.bottom + y), tag.top + y - card.bottom);
					if (gapX < GAP && gapY < GAP) {
						if (GAP - gapX <= GAP - gapY) x += Math.sign(dx || 1) * (GAP - gapX);
						else y += Math.sign(dy || 1) * (GAP - gapY);
					}
				}
				other.style.setProperty('--push-x', `${x.toFixed(1)}px`);
				other.style.setProperty('--push-y', `${y.toFixed(1)}px`);
			}
		};

		// The card replaces its tag at exactly the tag's size, then its frame is pulled
		// open to the card's one fixed size while the content fades in (data-expanded).
		// Closing runs backwards.
		const open = (item: HTMLElement) => {
			const card = item.querySelector<HTMLElement>('[data-card]');
			const tag = item.querySelector<HTMLElement>('.tag');
			if (!card || !tag) return;
			clearTimeout(closing.get(item));
			if (phone.matches) {
				card.style.width = card.style.height = '';
				item.setAttribute('data-open', '');
				item.setAttribute('data-expanded', '');
				return;
			}

			const from = item.hasAttribute('data-open')
				? { width: card.offsetWidth, height: card.offsetHeight } // reopened while closing
				: { width: tag.offsetWidth, height: tag.offsetHeight };
			item.setAttribute('data-open', '');

			// Measure the full size, make room for it, then open up to it from the starting size.
			card.style.transition = 'none';
			card.style.width = card.style.height = '';
			const to = { width: card.offsetWidth, height: card.offsetHeight };
			lift(item, to.height);
			makeRoom(item);
			card.style.width = `${from.width}px`;
			card.style.height = `${from.height}px`;
			card.getBoundingClientRect();
			card.style.transition = '';
			card.style.width = `${to.width}px`;
			card.style.height = `${to.height}px`;
			item.setAttribute('data-expanded', '');
		};

		const close = (item: HTMLElement) => {
			const card = item.querySelector<HTMLElement>('[data-card]');
			const tag = item.querySelector<HTMLElement>('.tag');
			if (!card || !tag || !item.hasAttribute('data-expanded')) return;
			item.removeAttribute('data-expanded');
			if (phone.matches) {
				item.removeAttribute('data-open');
				return;
			}

			card.style.width = `${tag.offsetWidth}px`;
			card.style.height = `${tag.offsetHeight}px`;
			item.style.setProperty('--lift', '0px');
			if (!items.some((other) => other.hasAttribute('data-expanded'))) makeRoom(null);
			closing.set(
				item,
				window.setTimeout(() => {
					item.removeAttribute('data-open');
					card.style.width = card.style.height = '';
				}, CLOSE_DURATION),
			);
		};

		const show = (item: HTMLElement | null) => items.forEach((other) => (other === item ? open(other) : close(other)));

		// Hovering (or tabbing to) a tag peeks at its project; clicking the tag goes straight to it.
		for (const item of items) {
			item.addEventListener('pointerenter', (e) => {
				if (e.pointerType !== 'mouse') return;
				clearTimeout(closeTimer);
				show(item);
			});
			item.addEventListener('pointerleave', (e) => {
				if (e.pointerType !== 'mouse') return;
				// A short delay gives the mouse time to cross the gap into the preview.
				closeTimer = window.setTimeout(() => close(item), 300);
			});
			item.addEventListener('focusin', () => !phone.matches && show(item));
			item.addEventListener('focusout', (e) => {
				if (!phone.matches && !item.contains(e.relatedTarget as Node)) close(item);
			});
			item.querySelector('.tag')?.addEventListener('click', (e) => {
				if (!phone.matches) return; // desktop: the tag links straight to the project
				e.preventDefault();
				if (item.hasAttribute('data-open')) close(item);
				else show(item);
			});
		}

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') show(null);
		});
	}
</script>

<style>
	.hero {
		--mx: 0;
		--my: 0;
		position: relative;
		height: max(58vw, 26rem);
		margin-top: -5rem; /* let the scene sit behind the header */
	}

	.float {
		position: absolute;
		translate:
			calc(var(--mx) * var(--depth) * 1px + var(--push-x, 0px))
			calc(var(--my) * var(--depth) * 1px + var(--push-y, 0px));
		transition:
			translate 1.2s cubic-bezier(0.2, 0.7, 0.2, 1),
			left 1.4s cubic-bezier(0.65, 0, 0.35, 1),
			top 1.4s cubic-bezier(0.65, 0, 0.35, 1),
			opacity 0.6s ease var(--appear),
			scale 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) var(--appear);
	}

	.hero__note {
		margin: 0;
		font-family: var(--font-hand);
		font-size: var(--text-subtitle);
		letter-spacing: 0.02em;
		white-space: nowrap;
	}

	/* The intro (see the script above). Femke's name in the middle, as on the about page… */
	.hero__name {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 6;
		display: grid;
		justify-items: start;
		gap: 0.1em;
		margin: 0;
		color: var(--color-accent);
		font-size: clamp(2.75rem, 6.3vw, 6rem);
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.04em;
		white-space: nowrap;
		translate: -50% -50%;
		pointer-events: none;
		visibility: hidden;
		transition: visibility 0s linear 1.2s;
	}

	.hero__name :global(.hero__first) {
		--handle: 0.14em;
		padding: 0.1em 0.12em 0.02em;
	}

	.hero__name > span:last-child {
		padding-left: 0.1em;
	}

	/* …whose halves leave towards both sides when the intro ends. */
	.hero__name :global(.hero__first),
	.hero__name > span:last-child {
		opacity: 0;
		transition:
			translate 1.1s cubic-bezier(0.7, 0, 0.3, 1),
			opacity 0.5s ease 0.6s;
	}

	.hero__name :global(.hero__first) {
		translate: -75vw 0;
	}

	.hero__name > span:last-child {
		translate: 75vw 0;
	}

	:global(html[data-intro]) .hero__name {
		visibility: visible;
		transition: none;
		animation: name-in 0.7s ease both;
	}

	:global(html[data-intro]) .hero__name :global(.hero__first),
	:global(html[data-intro]) .hero__name > span:last-child {
		opacity: 1;
		translate: none;
		transition: none;
	}

	@keyframes name-in {
		from { opacity: 0; scale: 0.96; }
	}

	/* Meanwhile the tags and the note wait, and the header with them. */
	:global(html[data-intro]) .float:not(.float--star) {
		opacity: 0;
		scale: 0.9;
		pointer-events: none;
	}

	:global(.header) {
		transition: opacity 0.6s ease 0.5s;
	}

	:global(html[data-intro] .header) {
		opacity: 0;
		transition: none;
	}

	/* The stars huddle around the name (`intro` positions, clear of the letters),
	   then drift out to their places. */
	@media (min-width: 641px) {
		:global(html[data-intro]) .float--star {
			left: var(--intro-x) !important;
			top: var(--intro-y) !important;
		}
	}

	.float[data-open] {
		z-index: 5;
	}

	.float__inner {
		translate: 0 calc(-1 * var(--lift, 0px));
		transition: translate 0.6s cubic-bezier(0.6, 0, 0.2, 1);
		animation: bob var(--bob-duration) var(--bob-delay) ease-in-out infinite alternate;
	}

	.float--star .float__inner {
		animation-name: bob-spin;
	}

	@keyframes bob {
		from { transform: translateY(-5px); }
		to { transform: translateY(5px); }
	}

	@keyframes bob-spin {
		from { transform: translateY(-6px) rotate(-8deg); }
		to { transform: translateY(6px) rotate(8deg); }
	}

	/* The card opens out of its tag: it sits exactly on top of it and takes over
	   (see open() above), so it only needs to appear and disappear here. */
	.float__panel {
		position: absolute;
		top: 0;
		left: 0;
		visibility: hidden;
		pointer-events: none;
	}

	/* Tags on the right open towards the left, so the card stays on screen. */
	.float__panel--end {
		left: auto;
		right: 0;
	}

	.float[data-open] .float__panel {
		visibility: visible;
		pointer-events: auto;
	}

	.float[data-open] :global(.tag) {
		opacity: 0;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (prefers-reduced-motion: reduce) {
		.float,
		.float__inner,
		.hero__name {
			transition: none;
		}

		.float__inner {
			animation: none;
		}
	}

	/* Without a mouse there's no hover: tapping a tag just opens the project. */
	/* Tablets without hover: tapping a tag simply opens the project. */
	@media (hover: none) and (min-width: 641px) {
		.float__panel {
			display: none;
		}
	}

	/* Phones: the tags stack in a zigzag and a tapped tag's card opens right below it. */
	@media (max-width: 640px) {
		.hero {
			display: flex;
			flex-direction: column;
			height: auto;
			margin-top: 0;
			padding: 4rem 0 7rem;
		}

		.float {
			translate: none;
			transition: opacity 0.6s ease var(--appear);
		}

		.float--note .hero__note {
			margin-left: var(--p-x);
		}

		.float:not(.float--star) {
			position: relative;
			left: 0 !important;
			top: 0 !important;
			order: var(--p-order);
			margin-top: var(--p-gap);
		}

		.float--star {
			left: var(--p-x) !important;
			top: var(--p-y) !important;
		}

		.float:not(.float--star) :global(.tag) {
			margin-left: var(--p-x);
		}

		.float__inner {
			translate: none;
		}

		.float__panel,
		.float__panel--end {
			position: static;
			display: none;
			margin: 1rem var(--gutter) 0;
		}

		.float[data-open] .float__panel {
			display: block;
			animation: card-in 0.35s ease;
		}

		.float[data-open] :global(.tag) {
			opacity: 1;
		}

		@keyframes card-in {
			from { opacity: 0; translate: 0 -0.5rem; }
		}
	}
</style>
