---
import SelectionTag from '../SelectionTag.astro';
import Star from '../Star.astro';
import ProjectPreview from './ProjectPreview.astro';
import { featuredProject, type Category } from '../../data/projects';

// Positions are percentages of the hero area, taken from the Figma design.
const tags: { label: string; x: number; y: number; accent?: boolean; href?: string; category?: Category }[] = [
	{ label: 'Visual Design', x: 19, y: 22, category: 'visual-design' },
	{ label: 'My portfolio', x: 71.5, y: 20, accent: true, href: '#work' },
	{ label: 'Integration of all courses', x: 47, y: 50, category: 'integration' },
	{ label: 'Motion Design', x: 76.5, y: 67, category: 'motion-design' },
	{ label: 'Coding & Development', x: 9, y: 75, category: 'coding' },
];

// A category tag becomes clickable as soon as it has a project in src/data/projects.ts.
const items = tags.map((tag) => {
	const project = tag.category && featuredProject(tag.category);
	return { ...tag, project, previewId: project ? `preview-${tag.category}` : undefined };
});

const stars = [
	{ x: 47.5, y: 15, size: '2.6vw', variant: 'outline' },
	{ x: 92.5, y: 26, size: '3.2vw', variant: 'filled' },
	{ x: 34.5, y: 48, size: '1.6vw', variant: 'filled' },
	{ x: 5, y: 57, size: '2.4vw', variant: 'outline-alt' },
	{ x: 62, y: 85, size: '2.4vw', variant: 'outline' },
] as const;
---

<section class="hero" aria-label="Intro">
	<h1 class="visually-hidden">Femke De Latter — design portfolio</h1>

	{items.map(({ label, x, y, accent, href, project, previewId }) => (
		<SelectionTag
			class:list={['hero__tag', { 'hero__tag--end': x > 40 }]}
			style={`left: ${x}%; top: ${y}%; anchor-name: --${previewId ?? 'none'}`}
			accent={accent}
			href={href}
			popovertarget={previewId}
		>
			{label}
		</SelectionTag>
	))}

	{items.map(({ project, previewId }) =>
		project && previewId && <ProjectPreview id={previewId} anchor={`--${previewId}`} project={project} />
	)}

	{stars.map(({ x, y, size, variant }) => (
		<Star
			class="hero__star"
			variant={variant}
			size={`max(${size}, 1rem)`}
			style={`left: ${x}%; top: ${y}%`}
		/>
	))}
</section>

<style>
	.hero {
		position: relative;
		height: max(58vw, 26rem);
		margin-top: -5rem; /* let the scene sit behind the header */
	}

	.hero :global(.hero__tag),
	.hero :global(.hero__star) {
		position: absolute;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.hero {
			height: 30rem;
		}

		/* Anchor right-side tags to the edge so they stay on screen. */
		.hero :global(.hero__tag--end) {
			left: auto !important;
			right: var(--gutter);
		}
	}
</style>
