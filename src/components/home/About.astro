---
import PhotoStrip from './PhotoStrip.astro';
import ObjectCallouts from './ObjectCallouts.astro';
import Star from '../Star.astro';

const captions = [
	"i'm 23 years old & located in Kortrijk, Belgium",
	'and slightly obsessed with my cat...',
	'but most importantly: i love being creative!',
];

const stars = [
	{ x: 58, y: 6, size: '1.3vw', variant: 'filled' },
	{ x: 93.5, y: 10, size: '1.3vw', variant: 'outline' },
	{ x: 21.5, y: 46, size: '2.2vw', variant: 'outline-alt' },
	{ x: 46, y: 67, size: '1.8vw', variant: 'filled' },
	{ x: 82.5, y: 90, size: '1.3vw', variant: 'outline' },
] as const;
---

<section class="about" aria-label="About me">
	<div class="about__strip">
		<PhotoStrip captions={captions} />
	</div>

	<div class="about__text">
		<p>
			As a student of Devine and a graduate of Industrial Product Design - Interior Design, my life is
			pretty much filled with design. I aim to be able to express my own creativity in my job later on.
		</p>
		<p>My favourite pastime? Finding inspiration in the most random everyday things.</p>
	</div>

	<div class="about__objects">
		<ObjectCallouts />
	</div>

	{stars.map(({ x, y, size, variant }) => (
		<Star
			class="about__star"
			variant={variant}
			size={`max(${size}, 0.9rem)`}
			style={`left: ${x}%; top: ${y}%`}
		/>
	))}
</section>

<style>
	.about {
		position: relative;
		display: grid;
		grid-template-columns: 22% 1fr 54%;
		grid-template-rows: auto 1fr;
		column-gap: 3vw;
		padding: 8vw 0 6vw;
	}

	.about__strip {
		grid-row: 1 / span 2;
		margin-top: -4vw;
	}

	.about__text {
		grid-column: 2 / span 2;
		max-width: 26rem;
		font-size: clamp(0.95rem, 1.2vw, 1.1rem);
		font-weight: 300;
		line-height: 1.5;
		letter-spacing: -0.02em;
	}

	.about__objects {
		grid-column: 3;
		grid-row: 2;
		align-self: start;
		margin-top: -6vw;
		padding-right: var(--gutter);
	}

	.about :global(.about__star) {
		position: absolute;
	}

	@media (max-width: 800px) {
		.about {
			grid-template-columns: 1fr;
			row-gap: 3rem;
			padding: 4rem var(--gutter);
		}

		.about__strip,
		.about__text,
		.about__objects {
			grid-column: 1;
			grid-row: auto;
			margin: 0;
			padding: 0;
			translate: none;
		}

		.about__strip {
			justify-self: center;
			width: min(60%, 13rem);
			padding-top: 3rem;
		}
	}
</style>
