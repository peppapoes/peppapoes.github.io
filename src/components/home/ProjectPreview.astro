---
/**
 * Framed preview of one project. The hero shows and positions it; without a
 * project it shows a "coming soon" frame.
 */
import { Image } from 'astro:assets';
import SelectionFrame from '../SelectionFrame.astro';
import { categoryLabels, projectUrl, type Project } from '../../data/projects';

interface Props {
	id: string;
	project?: Project;
}

const { id, project } = Astro.props;
const href = project && projectUrl(project);
---

<div id={id} class="preview" role="region" aria-label={project?.title ?? 'Coming soon'}>
	<SelectionFrame class="preview__frame">
		{project
			? <Image src={project.preview} alt={project.previewAlt} widths={[400, 600]} sizes="(max-width: 640px) 90vw, 26rem" />
			: <p class="preview__soon">project coming soon</p>}
	</SelectionFrame>

	{project && (
		<div class="preview__info">
			<ul class="preview__meta">
				<li>{project.previewTitle ?? project.title}</li>
				<li>{project.year} assignment</li>
				<li>{project.tagline ?? categoryLabels[project.category]}</li>
			</ul>

			<a class="preview__arrow" href={href} aria-label={`View ${project.title}`}>
				<svg viewBox="0 0 100 16" aria-hidden="true">
					<path d="M0 8H98M90 1l8 7-8 7" />
				</svg>
			</a>
		</div>
	)}
</div>

<style>
	.preview {
		width: min(26rem, 90vw);
		padding: 0.75rem;
		background: var(--color-bg);
		color: var(--color-fg);
	}

	.preview :global(.preview__frame) {
		--handle: 1.1rem;
		padding: 0.75rem;
	}

	.preview img {
		width: 100%;
		height: auto;
	}

	.preview__soon {
		display: grid;
		place-items: center;
		aspect-ratio: 600 / 407;
		margin: 0;
		font-family: var(--font-hand);
		font-size: 1.2rem;
	}

	.preview__info {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.75rem;
	}

	.preview__meta {
		display: grid;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-hand);
		font-size: 1.05rem;
	}

	.preview__arrow {
		width: 6.5rem;
		margin-top: 0.4rem;
		transition: translate 0.2s ease;
	}

	.preview__arrow:hover {
		translate: 0.4rem 0;
	}

	.preview__arrow svg {
		display: block;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
	}
</style>
