---
/**
 * Card previewing one project, shown when hovering a tag in the hero: the tag's
 * label as heading, the preview image and a few handwritten lines, all in one
 * selection frame that links to the project. Every preview has exactly the same
 * size. The hero pulls the frame open out of its tag (see its open()): only the
 * frame changes size, the content inside keeps its full size and is uncovered,
 * so nothing reflows while it opens.
 */
import { Image } from 'astro:assets';
import SelectionFrame from '../SelectionFrame.astro';
import { categoryLabels, projectUrl, type Project } from '../../data/projects';

interface Props {
	id: string;
	heading: string;
	project: Project;
	/** For tags on the right: the frame opens towards the left, so the heading stays on the right. */
	end?: boolean;
}

const { id, heading, project, end = false } = Astro.props;
---

<SelectionFrame
	as="a"
	id={id}
	class:list={['preview', { 'preview--end': end }]}
	data-card
	href={projectUrl(project)}
	aria-label={`${heading}: view ${project.title}`}
>
	<span class="preview__clip">
	<span class="preview__content">
	<span class="preview__heading">{heading}</span>

	<span class="preview__body">
	{project.preview && (
		<Image class="preview__image" src={project.preview} alt="" widths={[400, 600, 800]} sizes="(max-width: 640px) 80vw, 24rem" />
	)}

	<span class="preview__info">
		<span class="preview__meta">
			<span>{project.previewTitle ?? project.title}</span>
			<span>{project.year} assignment</span>
			<span>{project.tagline ?? categoryLabels[project.category]}</span>
		</span>

		<svg class="preview__arrow" viewBox="0 0 100 16" aria-hidden="true">
			<path d="M0 8H98M90 1l8 7-8 7" />
		</svg>
	</span>
	</span>
	</span>
	</span>
</SelectionFrame>

<style>
	/* Same font size, padding and handles as the tag it opens out of, so the heading
	   sits exactly where the tag's label was and doesn't change size. */
	.preview {
		--handle: 0.6em;
		--inset: 1.1em; /* the image and text sit a bit further in than the heading */
		display: block;
		width: fit-content;
		background: var(--color-bg);
		color: var(--color-fg);
		font-size: clamp(0.85rem, 1.35vw, 1.3rem);
		text-decoration: none;
		transition:
			width 0.6s cubic-bezier(0.6, 0, 0.2, 1),
			height 0.6s cubic-bezier(0.6, 0, 0.2, 1);
	}

	/* The frame is a window on the content, which always has its full size. */
	.preview__clip {
		display: flex;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.preview--end .preview__clip {
		justify-content: flex-end;
	}

	.preview__content {
		display: grid;
		flex: 0 0 auto;
		align-content: start;
		gap: 0.7rem;
		width: min(20rem, 85vw);
		padding: 0.35em 0.5em 1.1rem;
	}

	/* Everything but the heading fades in while the frame opens. */
	.preview__body {
		display: grid;
		gap: 0.7rem;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	:global([data-expanded]) .preview__body {
		opacity: 1;
		transition: opacity 0.35s ease 0.3s;
	}

	@media (prefers-reduced-motion: reduce) {
		.preview,
		.preview__body,
		:global([data-expanded]) .preview__body {
			transition: none;
		}
	}

	.preview:focus-visible {
		outline: 1px solid var(--color-fg);
		outline-offset: 6px;
	}

	.preview__heading {
		font-weight: 700;
		letter-spacing: -0.05em;
		white-space: nowrap;
	}

	.preview--end .preview__heading {
		justify-self: end;
	}

	.preview__image {
		width: calc(100% - 2 * var(--inset));
		height: auto;
		/* Every image is cropped to the same shape, so every frame is equally tall. */
		aspect-ratio: 3 / 2;
		object-fit: cover;
		margin-inline: var(--inset);
		filter: grayscale(1); /* previews are always black & white */
		transition: scale 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.preview:hover .preview__image {
		scale: 1.02;
	}

	.preview__info {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		padding-inline: calc(var(--inset) * 0.7) var(--inset);
	}

	.preview__meta {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
		font-family: var(--font-hand);
		font-size: 0.95rem;
	}

	/* One line each, so a long title can't make the frame taller. */
	.preview__meta span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.preview__arrow {
		flex: 0 0 auto;
		width: 3.75rem;
		margin-top: 0.3rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		transition: translate 0.3s ease;
	}

	.preview:hover .preview__arrow,
	.preview:focus-visible .preview__arrow {
		translate: 0.5rem 0;
	}

	/* On phones the tag stays above the card, so the heading would be doubled. */
	@media (max-width: 640px) {
		.preview__heading {
			display: none;
		}
	}
</style>
