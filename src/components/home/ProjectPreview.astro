---
/**
 * Framed preview of one project. The hero shows and positions it; without a
 * project it shows a "coming soon" frame.
 */
import { Image } from 'astro:assets';
import SelectionFrame from '../SelectionFrame.astro';
import { categoryLabels, projectUrl, type Project } from '../../data/projects';

interface Props {
	id: string;
	project?: Project;
}

const { id, project } = Astro.props;
const href = project && projectUrl(project);
---

<div id={id} class="preview" role="region" aria-label={project?.title ?? 'Coming soon'}>
	{project ? (
		<a class="preview__link" href={href} aria-label={`View ${project.title}`}>
			<SelectionFrame class="preview__frame">
				{project.preview && <Image src={project.preview} alt="" widths={[400, 600]} sizes="(max-width: 640px) 90vw, 26rem" />}
			</SelectionFrame>

			<span class="preview__info">
				<span class="preview__meta">
					<span>{project.previewTitle ?? project.title}</span>
					<span>{project.year} assignment</span>
					<span>{project.tagline ?? categoryLabels[project.category]}</span>
				</span>

				<svg class="preview__arrow" viewBox="0 0 100 16" aria-hidden="true">
					<path d="M0 8H98M90 1l8 7-8 7" />
				</svg>
			</span>
		</a>
	) : (
		<SelectionFrame class="preview__frame">
			<p class="preview__soon">project coming soon</p>
		</SelectionFrame>
	)}
</div>

<style>
	.preview {
		width: min(26rem, 90vw);
		padding: 0.75rem;
		background: var(--color-bg);
		color: var(--color-fg);
	}

	.preview :global(.preview__frame) {
		--handle: 1.1rem;
		padding: 0.75rem;
	}

	.preview img {
		width: 100%;
		height: auto;
		filter: grayscale(1); /* previews are always black & white */
	}

	.preview__soon {
		display: grid;
		place-items: center;
		aspect-ratio: 600 / 407;
		margin: 0;
		font-family: var(--font-hand);
		font-size: 1.2rem;
	}

	.preview__link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.preview__info {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.75rem;
	}

	.preview__meta {
		display: grid;
		gap: 0.35rem;
		font-family: var(--font-hand);
		font-size: 1.05rem;
	}

	.preview__arrow {
		flex: 0 0 auto;
		width: 6.5rem;
		margin-top: 0.4rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		transition: translate 0.3s ease;
	}

	.preview__link:hover .preview__arrow,
	.preview__link:focus-visible .preview__arrow {
		translate: 0.5rem 0;
	}

	.preview__link img {
		transition: scale 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.preview__link:hover img {
		scale: 1.03;
	}

	.preview__link:focus-visible {
		outline: 1px solid var(--color-fg);
		outline-offset: 6px;
	}
</style>
