---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import strip from '../../assets/images/polaroid-strip.png';

/**
 * Polaroid strip with a handwritten caption per frame, and optionally a photo in it.
 * The captions sit on the bottom of their frame, or with `callouts` beside the strip,
 * each at the end of a pink line that starts in its photo.
 */
interface Props {
	captions: string[];
	/** One square photo per frame, top to bottom. */
	photos?: ImageMetadata[];
	/** Mirrors the strip, so it leans the other way. */
	flip?: boolean;
	callouts?: boolean;
}

const { captions, photos = [], flip = false, callouts = false } = Astro.props;

// The three frames, measured in the image, as a percentage of it: the centre of each
// square frame, and where its caption is anchored (bottom centre).
const frames = [
	{ x: 35.6, y: 32.6, caption: { x: 36, y: 40.5 } },
	{ x: 43.5, y: 55, caption: { x: 44.5, y: 62.8 } },
	{ x: 51.7, y: 78.05, caption: { x: 53, y: 86 } },
];
const at = ({ x, y }: { x: number; y: number }) => `--x: ${flip ? 100 - x : x}%; --y: ${y}%`;
// A callout's line starts a little right of and below the middle of its frame.
const calloutAt = ({ x, y }: { x: number; y: number }) => `--line-x: ${(flip ? 100 - x : x) + 12}%; --line-y: ${y + 4}%`;
---

<figure class:list={['strip', { 'strip--flip': flip, 'strip--callouts': callouts }]}>
	<Image class="strip__image" src={strip} alt="" widths={[300, 600, 732]} sizes="(max-width: 800px) 13rem, 22vw" />

	{photos.map((photo, i) => (
		<Image class="strip__photo" src={photo} alt="" width={400} height={400} style={at(frames[i])} />
	))}

	{captions.map((caption, i) => (
		<figcaption class="strip__caption" style={`${at(frames[i].caption)}; ${calloutAt(frames[i])}`}>
			{callouts && <span class="strip__line"></span>}
			<span>{caption}</span>
		</figcaption>
	))}
</figure>

<style>
	.strip {
		--tilt: -7.5deg; /* how far the frames lean in the image */
		position: relative;
		width: 100%;
		max-width: 26rem;
		margin: 0;
		container-type: inline-size;
	}

	.strip--flip {
		--tilt: 7.5deg;
	}

	.strip__image {
		width: 100%;
		height: auto;
	}

	.strip--flip .strip__image {
		scale: -1 1;
	}

	/* Exactly covers its frame (a hair larger, so no black edge shows). */
	.strip__photo {
		position: absolute;
		top: var(--y);
		left: var(--x);
		width: 54.3%;
		max-width: none;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		translate: -50% -50%;
		rotate: var(--tilt);
		filter: grayscale(1);
	}

	.strip__caption {
		position: absolute;
		top: var(--y);
		left: var(--x);
		width: 48%;
		translate: -50% -100%;
		rotate: var(--tilt);
		font-family: var(--font-hand);
		font-size: 4.6cqi;
		line-height: 1.2;
		text-align: center;
		text-shadow: 0 0 0.5em rgb(0 0 0 / 0.8);
	}

	.strip__line {
		display: none;
	}

	/* Set by a page when something else covers the caption. */
	.strip__caption {
		transition: opacity 0.25s ease;
	}

	.strip__caption[data-covered] {
		opacity: 0;
	}

	/* Callouts: a pink line from the photo to a dot, with the caption after it. */
	.strip--callouts {
		--line: 70cqi; /* how long the line is */
		--line-gap: 6cqi; /* between the dot and the caption */
	}

	.strip--callouts .strip__caption {
		top: var(--line-y);
		left: var(--line-x);
		display: flex;
		align-items: center;
		gap: var(--line-gap);
		width: max-content;
		translate: 0 -50%;
		rotate: none;
		font-size: clamp(0.85rem, 1.05vw, 1.05rem);
		letter-spacing: 0.04em;
		text-shadow: none;
	}

	.strip--callouts .strip__caption > span:last-child {
		max-width: 12.5em;
		text-wrap: balance;
	}

	.strip--callouts .strip__line {
		position: relative;
		display: block;
		flex: 0 0 auto;
		width: var(--line);
		height: 1.5px;
		background: var(--color-accent);
	}

	.strip--callouts .strip__line::after {
		content: '';
		position: absolute;
		top: 50%;
		right: 0;
		width: 0.7em;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--color-accent);
		translate: 50% -50%;
	}

	/* On phones there's less room beside the strip: shorter lines and narrower captions. */
	@media (max-width: 800px) {
		.strip--callouts {
			--line: 22cqi;
			--line-gap: 4cqi;
		}

		.strip--callouts .strip__caption {
			font-size: 0.8rem;
			letter-spacing: 0.02em;
		}

		.strip--callouts .strip__caption > span:last-child {
			max-width: min(7.6em, 30cqi);
		}
	}
</style>
