---
/**
 * Photo-booth strip held by a clip. Each frame shows a photo (optional) with a
 * handwritten caption. Drop images in /public/images/ and pass their path as `src`.
 */
interface Frame {
	caption: string;
	src?: string;
	alt?: string;
}

interface Props {
	frames: Frame[];
	clipSrc?: string;
}

const { frames, clipSrc } = Astro.props;
---

<figure class="strip">
	{clipSrc ? <img class="strip__clip" src={clipSrc} alt="" /> : <span class="strip__clip strip__clip--placeholder" aria-hidden="true" />}

	<ul class="strip__frames">
		{frames.map(({ caption, src, alt = '' }) => (
			<li class="strip__frame">
				{src && <img src={src} alt={alt} loading="lazy" />}
				<span class="strip__caption">{caption}</span>
			</li>
		))}
	</ul>
</figure>

<style>
	.strip {
		position: relative;
		width: 100%;
		max-width: 17rem;
		margin: 0;
		rotate: -6deg;
		transform-origin: top center;
	}

	.strip__frames {
		display: grid;
		gap: 0.9rem;
		margin: 0;
		padding: 1.4rem 1rem 3.5rem;
		list-style: none;
		background: #f3f3f1;
		box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.4);
	}

	.strip__frame {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		aspect-ratio: 1 / 0.95;
		overflow: hidden;
		background: #0c0c0c;
	}

	.strip__frame img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.strip__caption {
		position: relative;
		padding: 0.5rem 0.75rem;
		font-family: var(--font-hand);
		font-size: 0.8rem;
		line-height: 1.2;
		text-align: center;
		rotate: -4deg;
	}

	.strip__clip {
		position: absolute;
		z-index: 1;
		top: -3.5rem;
		left: 50%;
		width: 7rem;
		translate: -50% 0;
	}

	.strip__clip--placeholder {
		height: 4.5rem;
		border-radius: 0.4rem 0.4rem 0.2rem 0.2rem;
		background: linear-gradient(90deg, #6f6f6f, #d9d9d9 45%, #8a8a8a);
	}
</style>
