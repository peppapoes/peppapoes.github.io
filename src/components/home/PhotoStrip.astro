---
import { Image } from 'astro:assets';
import strip from '../../assets/images/polaroid-strip.png';

/** Polaroid strip with a handwritten caption on the bottom of each frame. */
interface Props {
	captions: string[];
	/** Mirrors the strip, so it leans the other way. */
	flip?: boolean;
}

const { captions, flip = false } = Astro.props;

// Caption anchor points as a percentage of the image, matching the three frames.
const positions = [
	{ x: 36, y: 40.5 },
	{ x: 44.5, y: 62.8 },
	{ x: 53, y: 86 },
];
---

<figure class:list={['strip', { 'strip--flip': flip }]}>
	<Image src={strip} alt="" widths={[300, 600]} sizes="(max-width: 800px) 13rem, 22vw" />

	{captions.map((caption, i) => (
		<figcaption class="strip__caption" style={`left: ${flip ? 100 - positions[i].x : positions[i].x}%; top: ${positions[i].y}%`}>
			{caption}
		</figcaption>
	))}
</figure>

<style>
	.strip {
		position: relative;
		width: 100%;
		max-width: 20rem;
		margin: 0;
		container-type: inline-size;
	}

	.strip img {
		width: 100%;
		height: auto;
	}

	.strip__caption {
		position: absolute;
		width: 48%;
		translate: -50% -100%;
		rotate: -7deg;
		font-family: var(--font-hand);
		font-size: 4.6cqi;
		line-height: 1.2;
		text-align: center;
	}

	.strip--flip img {
		scale: -1 1;
	}

	.strip--flip .strip__caption {
		rotate: 7deg;
	}
</style>
