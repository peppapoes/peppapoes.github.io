---
/** Three short blocks, one per discipline, each linking to that filter on /work. */
import type { Category } from '../../data/projects';

// TODO: replace the placeholder sentences with Femke's own.
const disciplines: { category: Category; title: string; text: string }[] = [
	{
		category: 'visual-design',
		title: 'Visual design',
		text: 'Branding, typography and layouts that give an idea a face of its own.',
	},
	{
		category: 'motion-design',
		title: 'Motion design',
		text: 'Storyboards, styleframes and animation that bring a story to life.',
	},
	{
		category: 'coding',
		title: 'Coding & development',
		text: 'Websites and little games, built by hand in HTML, CSS and JavaScript.',
	},
];
---

<section class="does" aria-labelledby="does-heading">
	<h2 class="does__heading" id="does-heading">What I do</h2>

	<ul class="does__list">
		{disciplines.map(({ category, title, text }) => (
			<li>
				<a class="does__block" href={`/work?filter=${category}`}>
					<h3 class="does__title">{title}</h3>
					<p class="does__text">{text}</p>
					<span class="does__more">
						see the projects
						<svg viewBox="0 0 100 16" aria-hidden="true"><path d="M0 8H98M90 1l8 7-8 7" /></svg>
					</span>
				</a>
			</li>
		))}
	</ul>
</section>

<style>
	.does {
		margin: 0 var(--gutter);
		padding-block: clamp(2rem, 4vw, 4rem) clamp(4rem, 8vw, 7.5rem);
	}

	.does__heading {
		margin: 0 0 var(--subtitle-gap);
		padding-left: 0.4rem;
		font-family: var(--font-hand);
		font-size: var(--text-subtitle);
		font-weight: 400;
		letter-spacing: 0.02em;
	}

	/* Three equal columns with lines between them, above and underneath. */
	.does__list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin: 0;
		padding: 0;
		border-block: 1.5px solid var(--color-fg);
		list-style: none;
	}

	.does__list li + li {
		border-left: 1.5px solid var(--color-fg);
	}

	.does__block {
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: clamp(0.75rem, 1.4vw, 1.25rem);
		height: 100%;
		padding: clamp(1.25rem, 2.5vw, 2.25rem) clamp(1rem, 2.2vw, 2rem) clamp(1.25rem, 2.2vw, 2rem);
		color: inherit;
		text-decoration: none;
	}

	.does__block:focus-visible {
		outline: 1px solid var(--color-fg);
		outline-offset: -4px;
	}

	.does__title {
		margin: 0;
		font-size: clamp(1.6rem, 2.9vw, 2.75rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.06em;
		transition: color 0.2s ease;
	}

	.does__block:hover .does__title,
	.does__block:focus-visible .does__title {
		color: var(--color-accent);
	}

	.does__text {
		max-width: 24rem;
		margin: 0;
		font-size: var(--text-body);
		font-weight: 300;
		line-height: 1.35;
		letter-spacing: -0.02em;
	}

	.does__more {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-family: var(--font-hand);
		font-size: 0.95rem;
	}

	.does__more svg {
		width: 3.75rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		transition: translate 0.3s ease;
	}

	.does__block:hover svg,
	.does__block:focus-visible svg {
		translate: 0.5rem 0;
	}

	@media (max-width: 800px) {
		.does__list {
			grid-template-columns: minmax(0, 1fr);
		}

		.does__list li + li {
			border-top: 1.5px solid var(--color-fg);
			border-left: 0;
		}

		.does__block {
			padding-inline: 0.4rem;
		}
	}
</style>
