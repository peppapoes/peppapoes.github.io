---
import Star from './Star.astro';
import SocialLinks from './SocialLinks.astro';
import FooterStar from '../assets/images/footer_star.svg';

const links = [
	{ label: 'About Me', href: '/about' },
	{ label: 'My Work', href: '/work' },
	{ label: 'Contact', href: '/contact' },
];

// One element per letter, so hovering the logo can type them out one by one.
const letters = [...'FDSGNS'];

const current = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="header">
	<a href="/" class="logo" aria-label="FDSGNS — home">
		{letters.map((letter, i) => <span class="logo__letter" style={`--i: ${i}`} aria-hidden="true">{letter}</span>)}
		<Star variant="outline-alt" size="1.5em" class="logo__star" />
	</a>

	<nav aria-label="Main">
		<ul class="nav">
			{links.map(({ label, href }) => (
				<li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a></li>
			))}
		</ul>
	</nav>

	<button class="burger" type="button" aria-label="Open menu" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
		<span></span>
		<span></span>
		<span></span>
	</button>
</header>

<!-- Full-screen menu on phones. -->
<dialog class="menu" id="menu" aria-label="Menu" tabindex="-1">
	<div class="menu__top">
		<a href="/" class="logo" aria-label="FDSGNS — home">
			{letters.map((letter, i) => <span class="logo__letter" style={`--i: ${i}`} aria-hidden="true">{letter}</span>)}
			<Star variant="outline-alt" size="1.5em" class="logo__star" />
		</a>
		<button class="menu__close" type="button" aria-label="Close menu" data-menu-close></button>
	</div>

	<nav aria-label="Main">
		<ul class="menu__links">
			{links.map(({ label, href }) => (
				<li>
					<a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
						<span class="menu__label">
							{isCurrent(href) && <Star class="menu__star menu__star--before" variant="filled" size="0.45em" />}
							{label.toLowerCase()}
							{isCurrent(href) && <Star class="menu__star menu__star--after" variant="filled" size="0.45em" />}
						</span>
					</a>
				</li>
			))}
		</ul>
	</nav>

	<div class="menu__footer">
		<FooterStar class="menu__splash" aria-hidden="true" preserveAspectRatio="none" />
		<span class="menu__logo" aria-hidden="true">FDSGNS</span>
		<SocialLinks />
	</div>
</dialog>

<script>
	const menu = document.querySelector<HTMLDialogElement>('#menu')!;
	document.querySelector('[data-menu-open]')?.addEventListener('click', () => {
		menu.showModal();
		// A dialog focuses its first link when it opens, which would be the logo (with a
		// focus ring and its hover animation); keep the focus on the menu itself instead.
		menu.focus();
	});
	document.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
	menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.close()));
	// The menu is phone-only; close it if the screen grows past that.
	matchMedia('(min-width: 641px)').addEventListener('change', (e) => e.matches && menu.close());
</script>

<style>
	.header {
		position: relative;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: clamp(1.25rem, 2.5vw, 2.25rem) var(--gutter);
	}

	.logo {
		position: relative;
		font-size: clamp(0.85rem, 1.1vw, 1rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		text-decoration: none;
		transform-origin: left center;
		transition: scale 0.3s ease;
	}

	/* On hover the logo grows a little and is typed out again in pink, letter by letter. */
	.logo:hover,
	.logo:focus-visible {
		scale: 1.2;
	}

	.logo:hover .logo__letter,
	.logo:focus-visible .logo__letter {
		color: var(--color-accent);
		animation: type 0.01s calc(var(--i) * 90ms + 100ms) both;
	}

	@keyframes type {
		from { opacity: 0; }
	}

	.logo :global(.logo__star) {
		position: absolute;
		top: -0.7em;
		right: -1.4em;
		rotate: 12deg;
	}

	.nav {
		display: flex;
		gap: clamp(1rem, 3vw, 2.75rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav a {
		font-size: clamp(0.85rem, 1.1vw, 1.05rem);
		letter-spacing: -0.04em;
		text-decoration: none;
	}

	.nav a:hover,
	.nav a[aria-current='page'] {
		color: var(--color-accent);
	}

	/* Phone menu */
	.burger {
		display: none;
		flex-direction: column;
		gap: 0.45rem;
		padding: 0.25rem;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.burger span {
		width: 2.4rem;
		height: 0.4rem;
		background: var(--color-accent);
	}

	.menu {
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 0;
		overflow: hidden;
		border: 0;
		background: var(--color-bg);
		color: var(--color-fg);
	}

	.menu:focus {
		outline: none;
	}

	.menu[open] {
		display: flex;
		flex-direction: column;
		animation: menu-in 0.35s ease;
	}

	.menu::backdrop {
		background: var(--color-bg);
	}

	@keyframes menu-in {
		from { opacity: 0; }
	}

	.menu__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem var(--gutter);
	}

	.menu__close {
		position: relative;
		width: 2.4rem;
		height: 2.4rem;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.menu__close::before,
	.menu__close::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 0;
		width: 100%;
		height: 0.4rem;
		background: var(--color-accent);
		translate: 0 -50%;
		rotate: 45deg;
	}

	.menu__close::after {
		rotate: -45deg;
	}

	.menu__links {
		margin: 4rem calc(var(--gutter) + 1rem) 0;
		padding: 0;
		list-style: none;
	}

	.menu__links a {
		display: block;
		padding: 1.9rem 0;
		font-size: clamp(2.75rem, 15vw, 4.5rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.06em;
		text-align: center;
		text-decoration: none;
	}

	.menu__links a[aria-current='page'] {
		color: var(--color-accent);
	}

	/* The current page gets a pink star on each side. */
	.menu__label {
		position: relative;
		display: inline-block;
	}

	.menu__label :global(.menu__star) {
		position: absolute;
		top: 50%;
		color: currentColor;
		translate: 0 -40%;
	}

	.menu__label :global(.menu__star--before) {
		right: calc(100% + 0.15em);
	}

	.menu__label :global(.menu__star--after) {
		left: calc(100% + 0.15em);
	}

	.menu__footer {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-top: auto;
		padding: 0 var(--gutter) 1rem;
	}

	.menu__footer :global(.menu__splash) {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 68%;
		height: 8.5rem;
	}

	.menu__logo {
		position: relative;
		font-size: 13vw;
		font-weight: 700;
		line-height: 0.8;
		letter-spacing: -0.02em;
	}

	.menu__footer :global(.socials) {
		position: relative;
	}

	@media (max-width: 640px) {
		.header nav {
			display: none;
		}

		.burger {
			display: flex;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.menu[open],
		.logo:hover .logo__letter,
		.logo:focus-visible .logo__letter {
			animation: none;
		}
	}
</style>
