<ul class="socials">
	{socials.map(({ label, href, icon }) => (
		<li>
			<a href={href} aria-label={label} target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon} fill-rule="evenodd" /></svg>
			</a>
		</li>
	))}
</ul>

<style>
	.socials {
		display: flex;
		gap: 0.9rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.socials a {
		display: block;
		transition: transform 0.2s ease;
	}

	.socials a:hover {
		transform: translateY(-3px);
	}

	.socials svg {
		display: block;
		width: clamp(2rem, 3vw, 2.75rem);
		height: clamp(2rem, 3vw, 2.75rem);
		fill: var(--color-fg);
	}
</style>
