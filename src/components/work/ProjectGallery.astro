---
/** Full-width, horizontally scrollable strip of project images. */
import { Image } from 'astro:assets';
import type { Project } from '../../data/projects';

interface Props {
	images: NonNullable<Project['gallery']>;
}

const { images } = Astro.props;
---

<div class="gallery" data-gallery tabindex="0" aria-label="Project images">
	{images.map(({ src, alt }) => (
		<Image class="gallery__item" src={src} alt={alt} widths={[400, 800]} sizes="24rem" />
	))}
</div>

<style>
	.gallery {
		display: flex;
		gap: 1.25rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.gallery::-webkit-scrollbar {
		display: none;
	}

	.gallery:focus-visible {
		outline: 1px solid var(--color-fg);
		outline-offset: 4px;
	}

	.gallery__item {
		flex: 0 0 auto;
		width: clamp(14rem, 24vw, 22rem);
		aspect-ratio: 253 / 270;
		object-fit: cover;
		scroll-snap-align: center;
	}
</style>
