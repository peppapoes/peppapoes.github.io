---
/** App-style tile for a tool: two letters on a colour, or a small drawing (see src/data/tools.ts). */
import { tools, type Tool } from '../../data/tools';

interface Props {
	tool: Tool;
}

const tile = tools[Astro.props.tool];
---

<li class="tool" style={`--bg: ${tile.bg}; --fg: ${'fg' in tile ? tile.fg : 'inherit'}`} title={tile.name}>
	{'svg' in tile
		? <svg viewBox="0 0 48 48" aria-hidden="true" set:html={tile.svg} />
		: <span aria-hidden="true">{tile.short}</span>}
	<span class="visually-hidden">{tile.name}</span>
</li>

<style>
	/* Set --tool-size on a parent to change the size of its tiles. */
	.tool {
		--size: var(--tool-size, clamp(3.5rem, 5.2vw, 4.75rem));
		display: grid;
		flex: 0 0 auto;
		place-items: center;
		width: var(--size);
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 18%;
		background: var(--bg);
		color: var(--fg);
		font-size: calc(var(--size) * 0.5);
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.tool svg {
		width: 100%;
		height: 100%;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
