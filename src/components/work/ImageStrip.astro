---
/**
 * A row of small images that scrolls sideways and bleeds off the right edge of
 * the page. Scroll with a trackpad or shift + wheel, or drag it with the mouse.
 * With `layout="wall"` the images fill a few columns instead, nothing to scroll.
 * With `layout="board"` they fill justified rows (every row exactly as wide as the
 * others), with an optional large `feature` image beside them and a `palette` underneath.
 * With `collage` every image gets its own spot, exactly as in a design (stacked on phones).
 * Clicking an image opens it large in a popup, with arrows to browse the row
 * and the row's caption underneath.
 */
import { Image, getImage } from 'astro:assets';
import type { CollageItem, ProjectImage } from '../../data/projects';

interface Props {
	images: ProjectImage[];
	label: string;
	/** Shown under the large image in the popup, the same for every image in the row. */
	caption?: string;
	layout?: 'row' | 'wall' | 'board';
	/** Bigger images, for the end result. */
	large?: boolean;
	feature?: ProjectImage;
	collage?: { size: [number, number]; items: CollageItem[] };
	palette?: ProjectImage;
}

const { images: given, label, caption, layout: given_layout = 'row', feature, palette, large = false, collage } = Astro.props;
const images = collage ? collage.items : given;
const layout = collage ? 'collage' : given_layout;

// The large version for the popup.
const withFull = (list: ProjectImage[]) =>
	Promise.all(list.map(async ({ src, alt }) => ({ src, alt, full: await getImage({ src, width: Math.min(src.width, 2000) }) })));
const items = await withFull(images);
const [featureItem] = feature ? await withFull([feature]) : [];
const sizes = layout === 'row' ? '30vw' : '(max-width: 640px) 45vw, 20vw';
// In a large row, upright images (like phone screens) get extra height, so they don't look tiny.
const portrait = large && layout === 'row' && images.every(({ src }) => src.height > src.width * 1.4);
---

<div class:list={['strip', `strip--${layout}`, { 'strip--large': large, 'strip--portrait': portrait, 'strip--solo': layout === 'board' && !feature, 'strip--single': layout === 'wall' && images.length === 1 }]} data-strip={layout} role="region" aria-label={label} style={collage ? `--collage-ratio: ${collage.size[0]} / ${collage.size[1]}` : undefined}>
	{collage ? (
		collage.items.map(({ src, alt, at: [x, y, w, h], fit }, i) => (
			<button
				class:list={['strip__item', 'collage__item', { 'collage__item--contain': fit === 'contain' }]}
				type="button"
				data-full={items[i].full.src}
				aria-label={`View larger: ${alt}`}
				style={`left: ${(x / collage.size[0]) * 100}%; top: ${(y / collage.size[1]) * 100}%; width: ${(w / collage.size[0]) * 100}%; height: ${(h / collage.size[1]) * 100}%`}
			>
				<Image src={src} alt={alt} widths={[400, 800]} sizes="(max-width: 800px) 45vw, 25vw" loading="lazy" draggable="false" />
			</button>
		))
	) : layout === 'board' ? (
		<>
			<div class="board__wall">
				{items.map(({ src, alt, full }) => (
					<button class="strip__item" type="button" data-full={full.src} aria-label={`View larger: ${alt}`} style={`--ratio: ${(src.width / src.height).toFixed(3)}`}>
						<Image src={src} alt={alt} widths={[400, 800]} sizes={sizes} loading="lazy" draggable="false" />
					</button>
				))}
			</div>
			{featureItem && (
				<button class="strip__item board__feature" type="button" data-full={featureItem.full.src} aria-label={`View larger: ${featureItem.alt}`}>
					<Image src={featureItem.src} alt={featureItem.alt} widths={[600, 1000, 1400]} sizes="(max-width: 800px) 92vw, 35vw" loading="lazy" draggable="false" />
				</button>
			)}
			{palette && <Image class="board__palette" src={palette.src} alt={palette.alt} widths={[800, 1400, 2000]} sizes="92vw" loading="lazy" />}
		</>
	) : (
		items.map(({ src, alt, full }) => (
			<button class="strip__item" type="button" data-full={full.src} aria-label={`View larger: ${alt}`}>
				<Image src={src} alt={alt} widths={[400, 800, 1200]} sizes={images.length === 1 ? '(max-width: 1200px) 92vw, 72rem' : sizes} loading="lazy" draggable="false" />
			</button>
		))
	)}
</div>

<dialog class="lightbox" aria-label={label}>
	<button class="lightbox__close" type="button" data-close aria-label="Close">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
	</button>

	<button class="lightbox__arrow lightbox__arrow--prev" type="button" data-step="-1" aria-label="Previous image">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h18M13 4l8 8-8 8" /></svg>
	</button>

	<img class="lightbox__image" data-image alt="" />

	<button class="lightbox__arrow lightbox__arrow--next" type="button" data-step="1" aria-label="Next image">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h18M13 4l8 8-8 8" /></svg>
	</button>

	<div class="lightbox__info">
		<p class="lightbox__count" data-count aria-live="polite"></p>
		{caption && <p class="lightbox__caption">{caption}</p>}
	</div>
</dialog>

<script>
	for (const strip of document.querySelectorAll<HTMLElement>('[data-strip]')) {
		// Drag to scroll with a mouse (touch and trackpads scroll natively).
		let startX = 0;
		let startScroll = 0;
		let pressed = false;
		let dragged = false;

		const stop = () => {
			pressed = false;
			strip.classList.remove('is-dragging');
			setTimeout(() => (dragged = false));
		};
		strip.addEventListener('pointerdown', (e) => {
			if (e.pointerType !== 'mouse' || e.button !== 0 || strip.dataset.strip !== 'row') return;
			pressed = true;
			dragged = false;
			startX = e.clientX;
			startScroll = strip.scrollLeft;
		});
		strip.addEventListener('pointermove', (e) => {
			if (!pressed) return;
			if (e.buttons === 0) return stop();
			const moved = e.clientX - startX;
			// Only a real drag takes over, so a plain click still reaches the image.
			if (!dragged && Math.abs(moved) > 5) {
				dragged = true;
				strip.setPointerCapture(e.pointerId);
				strip.classList.add('is-dragging');
			}
			if (dragged) strip.scrollLeft = startScroll - moved;
		});
		strip.addEventListener('pointerup', stop);
		strip.addEventListener('pointercancel', stop);
		// Letting go of a drag on top of an image shouldn't open it.
		strip.addEventListener('click', (e) => dragged && e.stopPropagation(), true);

		// Click an image to see it large; browse the row with the arrows, arrow keys or a swipe.
		const lightbox = strip.nextElementSibling as HTMLDialogElement;
		const items = [...strip.querySelectorAll<HTMLButtonElement>('[data-full]')];
		const image = lightbox.querySelector<HTMLImageElement>('[data-image]')!;
		const count = lightbox.querySelector<HTMLElement>('[data-count]')!;
		let current = 0;

		const at = (index: number) => items[(index + items.length) % items.length];
		const go = (index: number) => {
			current = (index + items.length) % items.length;
			image.src = at(current).dataset.full!;
			image.alt = at(current).querySelector('img')!.alt;
			count.textContent = `${current + 1} / ${items.length}`;
			// Load the neighbours already, so stepping through feels instant.
			for (const step of [1, -1]) new Image().src = at(current + step).dataset.full!;
		};

		lightbox.toggleAttribute('data-single', items.length < 2);
		items.forEach((item, index) =>
			item.addEventListener('click', () => {
				go(index);
				lightbox.showModal();
			}),
		);
		for (const arrow of lightbox.querySelectorAll<HTMLElement>('[data-step]')) {
			arrow.addEventListener('click', () => go(current + Number(arrow.dataset.step)));
		}
		lightbox.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') go(current + 1);
			if (e.key === 'ArrowLeft') go(current - 1);
		});

		let touchX = 0;
		lightbox.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
		lightbox.addEventListener('touchend', (e) => {
			const moved = e.changedTouches[0].clientX - touchX;
			if (Math.abs(moved) > 50) go(current + (moved < 0 ? 1 : -1));
		});

		// Close with the cross, Esc, or a click next to the image.
		lightbox.querySelector('[data-close]')!.addEventListener('click', () => lightbox.close());
		lightbox.addEventListener('click', (e) => e.target === lightbox && lightbox.close());
		lightbox.addEventListener('close', () => image.removeAttribute('src'));
	}
</script>

<style>
	.strip {
		display: flex;
		gap: clamp(0.5rem, 1vw, 1rem);
		margin-right: calc(-1 * var(--gutter));
		padding-right: var(--gutter);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		cursor: grab;
	}

	.strip::-webkit-scrollbar {
		display: none;
	}

	.strip.is-dragging {
		cursor: grabbing;
	}

	.strip__item {
		flex: 0 0 auto;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
		user-select: none;
	}

	.strip.is-dragging .strip__item {
		cursor: grabbing;
	}

	.strip__item:focus-visible {
		outline: 1px solid var(--color-fg);
		outline-offset: -1px;
	}

	/* Every image in a row is equally tall. */
	.strip__item img {
		width: auto;
		max-width: none;
		height: clamp(8.5rem, 17vw, 17rem);
		object-fit: cover;
		transition: opacity 0.2s ease;
	}

	.strip--large .strip__item img {
		height: clamp(11rem, 24vw, 23rem);
	}

	.strip--portrait .strip__item img {
		height: clamp(17rem, 34vw, 32rem);
	}

	.strip__item:hover img {
		opacity: 0.8;
	}

	/* A wall of images in columns, each at its own proportions. */
	.strip--wall {
		display: block;
		columns: 5;
		column-gap: clamp(0.5rem, 1vw, 1rem);
		margin-right: 0;
		padding-right: 0;
		overflow: visible;
		cursor: auto;
	}

	.strip--wall .strip__item {
		display: block;
		width: 100%;
		margin-bottom: clamp(0.5rem, 1vw, 1rem);
		break-inside: avoid;
	}

	.strip--wall .strip__item img {
		width: 100%;
		height: auto;
	}

	/* A single image (like one styleboard) is shown large, across the page. */
	.strip--wall.strip--single {
		columns: 1;
		max-width: 72rem;
	}

	@media (max-width: 1000px) {
		.strip--wall:not(.strip--single) {
			columns: 3;
		}
	}

	@media (max-width: 640px) {
		.strip--wall:not(.strip--single) {
			columns: 2;
		}
	}

	/* A collage: every image at its spot from the design, scaled with the width. */
	.strip--collage {
		position: relative;
		display: block;
		aspect-ratio: var(--collage-ratio);
		margin-right: 0;
		padding-right: 0;
		overflow: visible;
		cursor: auto;
	}

	.collage__item {
		position: absolute;
	}

	.strip--collage .strip__item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.strip--collage .collage__item--contain img {
		object-fit: contain;
	}

	/* On phones the images stack in two columns instead. */
	@media (max-width: 800px) {
		.strip--collage {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.6rem;
			aspect-ratio: auto;
		}

		.collage__item {
			position: static;
			width: auto !important;
			height: auto !important;
		}

		.strip--collage .strip__item img {
			height: auto;
		}
	}

	/* A board: justified rows on the left (each image grows with its proportions,
	   so every row is equally wide), a large image on the right, the palette below. */
	.strip--board {
		--gap: clamp(0.5rem, 1vw, 0.9rem);
		display: grid;
		grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
		gap: var(--gap);
		margin-right: 0;
		padding-right: 0;
		overflow: visible;
		cursor: auto;
	}

	/* Without a large image the rows take the full width. */
	.strip--solo {
		grid-template-columns: minmax(0, 1fr);
	}

	.board__wall {
		display: flex;
		flex-wrap: wrap;
		align-content: start;
		gap: var(--gap);
	}

	.board__wall::after {
		content: '';
		flex-grow: 1000; /* the last row doesn't stretch its few images */
	}

	.board__wall .strip__item {
		flex: var(--ratio) 1 calc(var(--ratio) * clamp(8rem, 12.5vw, 12.5rem));
	}

	.strip--board .strip__item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* As tall as the rows beside it, cropped to fit. */
	.board__feature {
		position: relative;
		min-height: 18rem;
	}

	.strip--board .board__feature img {
		position: absolute;
		inset: 0;
	}

	/* Always the same height, so a short palette stays small and a long one fills the width. */
	.board__palette {
		grid-column: 1 / -1;
		width: auto;
		max-width: 100%;
		height: clamp(3.5rem, 5.5vw, 5rem);
		object-fit: contain;
		object-position: left;
	}

	@media (max-width: 800px) {
		.strip--board {
			grid-template-columns: minmax(0, 1fr);
		}

		.board__feature {
			aspect-ratio: 4 / 5;
		}
	}

	/* The popup: the image between two arrows, with the count and caption underneath. */
	.lightbox {
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: clamp(3.5rem, 6vw, 4.5rem) var(--gutter) clamp(1rem, 2.5vw, 2rem);
		border: 0;
		background: rgb(0 0 0 / 0.93);
		color: var(--color-fg);
		grid-template: 'prev image next' minmax(0, 1fr) '. info .' auto / auto minmax(0, 1fr) auto;
		gap: clamp(1rem, 2vw, 1.75rem) clamp(1rem, 3vw, 3rem);
		align-items: center;
	}

	.lightbox[open] {
		display: grid;
		animation: lightbox-in 0.25s ease;
	}

	.lightbox::backdrop {
		background: none;
	}

	@keyframes lightbox-in {
		from { opacity: 0; }
	}

	:global(html:has(dialog[open])) {
		overflow: hidden;
	}

	.lightbox__image {
		grid-area: image;
		place-self: center;
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: 100%;
	}

	.lightbox__arrow,
	.lightbox__close {
		display: grid;
		place-items: center;
		padding: 0;
		border: 1.5px solid var(--color-fg);
		background: var(--color-bg);
		color: var(--color-fg);
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.lightbox__arrow {
		width: clamp(3rem, 5vw, 4.25rem);
		aspect-ratio: 1;
	}

	.lightbox__arrow--prev {
		grid-area: prev;
	}

	.lightbox__arrow--next {
		grid-area: next;
	}

	.lightbox__arrow--prev svg {
		scale: -1 1;
	}

	.lightbox[data-single] .lightbox__arrow,
	.lightbox[data-single] .lightbox__count {
		visibility: hidden;
	}

	.lightbox__close {
		position: absolute;
		top: clamp(0.75rem, 1.5vw, 1.25rem);
		right: var(--gutter);
		width: 2.5rem;
		aspect-ratio: 1;
	}

	.lightbox svg {
		width: 55%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		transition: translate 0.3s ease;
	}

	.lightbox__arrow:hover,
	.lightbox__arrow:focus-visible,
	.lightbox__close:hover,
	.lightbox__close:focus-visible {
		border-color: var(--color-accent);
		color: var(--color-accent);
		outline: none;
	}

	.lightbox__arrow--next:hover svg {
		translate: 0.2rem 0;
	}

	.lightbox__arrow--prev:hover svg {
		translate: -0.2rem 0;
	}

	.lightbox__info {
		grid-area: info;
		display: grid;
		gap: 0.4rem;
		justify-items: center;
		text-align: center;
	}

	.lightbox__info p {
		margin: 0;
	}

	.lightbox__count {
		font-family: var(--font-hand);
		font-size: 1.1rem;
	}

	.lightbox__caption {
		max-width: 44rem;
		font-size: var(--text-body);
		font-weight: 300;
		line-height: 1.35;
		letter-spacing: -0.02em;
	}

	@media (prefers-reduced-motion: reduce) {
		.lightbox[open] {
			animation: none;
		}
	}

	/* On phones the image gets the full width and the arrows move underneath. */
	@media (max-width: 640px) {
		.lightbox {
			grid-template: 'image image' minmax(0, 1fr) 'info info' auto 'prev next' auto / 1fr 1fr;
		}

		.lightbox__arrow--prev {
			justify-self: end;
		}
	}
</style>
