---
/** One project in the /work list, linking to its own page. */
import { Image } from 'astro:assets';
import { categoryLabels, projectUrl, type Project } from '../../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<li class="row" data-category={project.category}>
	<a class="row__link" href={projectUrl(project)}>
		<span class="row__heading">
			<span class="row__category">{categoryLabels[project.category]}</span>
			<span class="row__title">{project.title}</span>
		</span>
		{project.preview && (
			<Image
				class="row__image"
				src={project.preview}
				alt={project.previewAlt ?? ''}
				widths={[400, 600]}
				sizes="(max-width: 800px) 90vw, 20vw"
			/>
		)}
		<span class="row__year">{project.year}</span>
	</a>
</li>

<style>
	.row {
		border-top: 1.5px solid var(--color-fg);
	}

	.row__link {
		display: grid;
		grid-template-columns: 1fr auto minmax(4rem, 8vw);
		align-items: start;
		gap: 2rem;
		min-height: clamp(10rem, 16vw, 15rem);
		padding-block: clamp(1.5rem, 2.5vw, 2.25rem);
		color: inherit;
		text-decoration: none;
	}

	.row__link:focus-visible {
		outline: 1px solid var(--color-fg);
		outline-offset: 4px;
	}

	.row__heading {
		display: grid;
		gap: 0.2em;
		padding-top: 1rem;
	}

	.row__category {
		font-family: var(--font-hand);
		font-size: clamp(1.1rem, 1.8vw, 1.6rem);
	}

	.row__title {
		font-size: clamp(2.25rem, 4.2vw, 4rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.06em;
		transition: translate 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.row__link:hover .row__title,
	.row__link:focus-visible .row__title {
		translate: 0.4rem 0;
	}

	.row__image {
		grid-column: 2;
		width: clamp(12rem, 20vw, 21.5rem);
		height: auto;
		aspect-ratio: 345 / 233;
		object-fit: cover;
		filter: grayscale(1); /* previews are always black & white */
	}

	.row__year {
		grid-column: 3;
		justify-self: end;
		font-size: clamp(1rem, 1.35vw, 1.3rem);
		letter-spacing: -0.03em;
	}

	@media (max-width: 800px) {
		.row__link {
			grid-template-columns: 1fr auto;
			gap: 1rem;
			min-height: 0;
		}

		.row__heading {
			padding-top: 0;
		}

		.row__year {
			grid-column: 2;
			grid-row: 1;
		}

		/* A flat, wide crop, so each project takes up less height. */
		.row__image {
			grid-column: 1 / -1;
			grid-row: 2;
			width: 100%;
			min-width: 0;
			aspect-ratio: 5 / 2;
		}
	}
</style>
