---
/**
 * A label in a selection frame. Renders a link with `href`, a button that
 * opens a popover with `popovertarget`, or plain text otherwise.
 */
import SelectionFrame from './SelectionFrame.astro';

interface Props {
	href?: string;
	popovertarget?: string;
	accent?: boolean;
	class?: string;
	style?: string;
}

const { href, popovertarget, class: className, ...rest } = Astro.props;
const as = href ? 'a' : popovertarget ? 'button' : 'span';
---

<SelectionFrame
	as={as}
	href={href}
	popovertarget={popovertarget}
	type={as === 'button' ? 'button' : undefined}
	class:list={['tag', { 'tag--interactive': as !== 'span' }, className]}
	{...rest}
>
	<slot />
</SelectionFrame>

<style>
	.tag {
		display: inline-block;
		padding: 0.35em 0.5em;
		background: none;
		font: inherit;
		font-size: clamp(0.85rem, 1.35vw, 1.3rem);
		font-weight: 700;
		letter-spacing: -0.05em;
		text-decoration: none;
		white-space: nowrap;
		transition: transform 0.2s ease;
	}

	.tag--interactive {
		cursor: pointer;
	}

	.tag--interactive:hover,
	.tag--interactive:focus-visible {
		transform: scale(1.05);
	}
</style>
