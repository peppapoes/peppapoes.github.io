---
/**
 * A label in a selection frame. Renders a link with `href`, a button with
 * `button`, or plain text otherwise. Other attributes are passed through.
 */
import type { HTMLAttributes } from 'astro/types';
import SelectionFrame from './SelectionFrame.astro';

interface Props extends HTMLAttributes<'span'> {
	href?: string;
	button?: boolean;
	accent?: boolean;
}

const { href, button = false, class: className, ...rest } = Astro.props;
const as = href ? 'a' : button ? 'button' : 'span';
---

<SelectionFrame
	as={as}
	href={href}
	type={as === 'button' ? 'button' : undefined}
	class:list={['tag', { 'tag--interactive': as !== 'span' }, className]}
	{...rest}
>
	<slot />
</SelectionFrame>

<style>
	.tag {
		display: inline-block;
		padding: 0.35em 0.5em;
		background: none;
		font: inherit;
		font-size: clamp(0.85rem, 1.35vw, 1.3rem);
		font-weight: 700;
		letter-spacing: -0.05em;
		text-decoration: none;
		white-space: nowrap;
		transition: scale 0.3s ease;
	}

	.tag--interactive {
		cursor: pointer;
	}

	.tag--interactive:hover,
	.tag--interactive:focus-visible,
	.tag--interactive[aria-expanded='true'] {
		scale: 1.05;
	}
</style>
