---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SelectionFrame from '../components/SelectionFrame.astro';
import ToolIcon from '../components/work/ToolIcon.astro';
import PhotoStrip from '../components/home/PhotoStrip.astro';
import { skills } from '../data/tools';
import portrait from '../assets/images/femke.jpg';
import artSchool from '../assets/images/artschool.jpg';
import ipo from '../assets/images/IPO.jpg';
import devine from '../assets/images/DEVINE.jpg';

// Three topics; one is open at a time (see the script below).
const tabs = [
	{ id: 'femke', label: 'Femke' },
	{ id: 'skills', label: 'Skills' },
	{ id: 'studies', label: 'Studies' },
];
const panelAttrs = (id: string, open = false) => ({
	id: `panel-${id}`,
	role: 'tabpanel',
	'aria-labelledby': `tab-${id}`,
	hidden: !open,
});

// Oldest first. `short` and `photo` go on the photo strip; `note` is an extra line in pink.
const studies = [
	{
		name: 'Secondary Art School',
		years: '2015 - 2021',
		short: 'KSO - Art school',
		photo: artSchool,
		text: 'From a young age, I knew my world revolved around creativity, so I pursued it right away in secondary school. There, I truly learned to draw and studied visual design, art history, architectural design and much more. This programme broadened my view of the future, because the world needs creative minds, now more than ever!',
	},
	{
		name: 'Bachelor IPO - Industrial product Design, Interior Design',
		years: '2021 - 2024',
		short: 'IPO - Industrial Product Design / Interior Design',
		photo: ipo,
		text: 'After my art studies, I chose to continue in the world of design, specialising in Product Design with an elective track in Interior Design. I learned to design spatially, to develop products based on research and design briefs, and to bring them to life through prototyping and scale models. Along the way, I learned how to work with clients, collaborate in teams, design briefings, … It was a very hands-on programme, and that appealed to me enormously.',
		note: 'During my studies at IPO, I did an internship at Sundo in Bissegem, where I helped design a sun-safe workspace.',
	},
	{
		name: 'Bachelor Devine - Digital Design and Development',
		years: '2024 - now',
		short: 'DEVINE - Digital Design & Development',
		photo: devine,
		text: 'The Devine programme offers a broad curriculum covering Visual Design, Web Development and Creative Coding, Motion Design, and Experience Design. I love this field because it takes my passion for design a step further by bringing it into the digital world. We’re given a lot of freedom in the choices we make and in how we develop our ideas, which only motivates me more. I study on Buda Island (Dam 2) in Kortrijk, and so far I’ve completed every course without a single resit.',
	},
];
---

<Layout title="About Me — FDSGNS" description="About Femke De Latter: who she is, her design, development and modelling skills, and her studies.">
	<div class="about">
		<h1 class="about__title">
			<SelectionFrame as="span" accent class="about__title-first">FEMKE</SelectionFrame>
			<span>DE LATTER</span>
		</h1>

		<div class="about__main">
			<div class="tabs" role="tablist" aria-label="About me">
				{tabs.map(({ id, label }, i) => (
					<button
						class="tabs__tab"
						id={`tab-${id}`}
						type="button"
						role="tab"
						aria-selected={i === 0 ? 'true' : 'false'}
						aria-controls={`panel-${id}`}
						data-topic={id}
					>
						{label}
					</button>
				))}
			</div>

			<section class="panel panel--femke" {...panelAttrs('femke', true)}>
				<!-- In reading order for phones: there the portrait comes after the first paragraph. -->
				<h2 class="panel__heading">Get to know me a bit</h2>
				<p>
					Hi, I’m Femke! I’m a Devine student in my twenties and in the prime of my life. I’m very eager to learn, and
					I love finding inspiration and little things to discover wherever I go.
				</p>
				<Image
					class="panel__portrait"
					src={portrait}
					alt="Femke swinging a long dark scarf above her head, smiling"
					widths={[320, 640]}
					sizes="(max-width: 800px) 60vw, 22vw"
				/>
				<p>
					In my free time, you’ll find me at home listening to music on vinyl, sketching, scrapbooking, designing, or
					doing anything else that doesn’t require taking life too seriously. Design and music are my two great
					passions; they’re what make my days brighter. (Along with my roommate, my cat Peppa.)
				</p>
				<p>
					As a student, I’m highly driven. I work well under pressure, always aim to meet my deadlines and strive to
					pass every course the first time, which I’ve managed to do so far! I look forward to a future in which the
					passion I put into my studies becomes the heart of my career.
				</p>
			</section>

			<section class="panel panel--skills" {...panelAttrs('skills')}>
				{skills.map(({ title, tools }) => (
					<div class="skillset">
						<h2 class="panel__heading">{title}</h2>
						<ul class="skillset__tools">
							{tools.map((tool) => <ToolIcon tool={tool} />)}
						</ul>
					</div>
				))}
			</section>

			<section class="panel panel--studies" {...panelAttrs('studies')}>
				<h2 class="panel__heading">Studies</h2>
				<ul class="studies">
					{studies.map(({ name, years, text, note }) => (
						<li class="study">
							<h3 class="study__name">{name}</h3>
							<p class="study__years">{years}</p>
							<p class="study__text">{text}</p>
							{note && <p class="study__text study__text--note">{note}</p>}
						</li>
					))}
				</ul>
				<div class="panel__strip" aria-hidden="true">
					<PhotoStrip captions={studies.map(({ short }) => short)} photos={studies.map(({ photo }) => photo)} flip callouts />
				</div>
			</section>
		</div>
	</div>
</Layout>

<script>
	const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs [data-topic]')];

	const show = (tab: HTMLButtonElement) => {
		for (const other of tabs) {
			other.setAttribute('aria-selected', String(other === tab));
			other.tabIndex = other === tab ? 0 : -1;
			document.getElementById(other.getAttribute('aria-controls')!)!.hidden = other !== tab;
		}
	};

	tabs.forEach((tab, i) => {
		tab.addEventListener('click', () => {
			show(tab);
			// Keep the open topic in the URL (e.g. /about#skills) so it can be shared.
			history.replaceState(null, '', i === 0 ? location.pathname : `#${tab.dataset.topic}`);
		});
		// Arrow keys move between the tabs.
		tab.addEventListener('keydown', (e) => {
			const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
			if (!step) return;
			const next = tabs[(i + step + tabs.length) % tabs.length];
			next.focus();
			next.click();
		});
	});

	// The name stays put while the page scrolls; a photo strip caption that slides
	// underneath it fades out (see PhotoStrip's data-covered).
	const title = document.querySelector<HTMLElement>('.about__title')!;
	if (getComputedStyle(title).position === 'sticky') {
		const covered = parseFloat(getComputedStyle(title).top) + title.offsetHeight + 12;
		const observer = new IntersectionObserver(
			(entries) => entries.forEach((entry) => entry.target.toggleAttribute('data-covered', entry.intersectionRatio < 1)),
			{ rootMargin: `-${covered}px 0px 2000px 0px`, threshold: 1 },
		);
		document.querySelectorAll('.panel__strip figcaption').forEach((caption) => observer.observe(caption));
	}

	const fromUrl = () => show(tabs.find((tab) => `#${tab.dataset.topic}` === location.hash) ?? tabs[0]);
	addEventListener('hashchange', fromUrl);
	fromUrl();
</script>

<style>
	/* Topics on the left, the name on the right. */
	.about {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas: 'main title';
		column-gap: clamp(1.5rem, 2.5vw, 3rem);
		align-items: start;
		margin: 0 var(--gutter);
		padding: clamp(1rem, 2.5vw, 2.5rem) 0 clamp(5rem, 10vw, 9rem);
	}

	.about__title {
		grid-area: title;
		display: grid;
		justify-items: start;
		gap: 0.1em;
		margin: 0;
		color: var(--color-accent);
		font-size: clamp(3.5rem, 6.3vw, 6rem);
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.04em;
		white-space: nowrap;
		/* Stays in view while the page scrolls, like the title on /work. */
		position: sticky;
		top: 2rem;
	}

	.about__title :global(.about__title-first) {
		--handle: 0.14em;
		padding: 0.1em 0.12em 0.02em;
	}

	.about__title > span:last-child {
		padding-left: 0.1em;
	}

	.about__main {
		--strip-width: clamp(13rem, 21vw, 25rem); /* the photo strip under Studies */
		grid-area: main;
		position: relative;
	}

	.tabs {
		display: flex;
		gap: clamp(1.75rem, 4vw, 4rem);
		margin-top: clamp(0.5rem, 1.6vw, 1.5rem);
		padding-bottom: clamp(0.9rem, 1.8vw, 1.6rem);
		border-bottom: 1.5px solid var(--color-fg);
	}

	/* Under Studies the line stops at the clip the photo strip hangs from. */
	.about__main:has(.panel--studies:not([hidden])) .tabs {
		margin-right: calc(var(--strip-width) * 0.36 - 1.5vw);
	}

	.tabs__tab {
		padding: 0.25em 0;
		border: 0;
		background: none;
		color: var(--color-fg);
		font: inherit;
		font-size: clamp(1.05rem, 1.5vw, 1.4rem);
		letter-spacing: -0.04em;
		cursor: pointer;
		transition: color 0.2s ease;
	}

	.tabs__tab:hover,
	.tabs__tab[aria-selected='true'] {
		color: var(--color-accent);
	}

	/* Bold without the other tabs shifting. */
	.tabs__tab[aria-selected='true'] {
		-webkit-text-stroke: 0.045em currentColor;
	}

	.tabs__tab:focus-visible {
		outline: 1px solid var(--color-fg);
		outline-offset: 4px;
	}

	.panel {
		position: relative;
		padding-top: clamp(1.75rem, 3vw, 2.75rem);
	}

	.panel:not([hidden]) {
		animation: fade-in 0.4s ease;
	}

	@keyframes fade-in {
		from { opacity: 0; }
	}

	.panel__heading {
		margin: 0 0 var(--subtitle-gap);
		font-family: var(--font-hand);
		font-size: var(--text-subtitle);
		font-weight: 400;
		letter-spacing: 0.02em;
	}

	.panel p {
		margin: 0;
		font-size: var(--text-body);
		font-weight: 300;
		line-height: 1.35;
		letter-spacing: -0.02em;
	}

	/* Femke: her portrait in the left column, the text stacked in the right one. */
	.panel--femke:not([hidden]) {
		display: grid;
		grid-template-columns: 35% minmax(0, 36rem);
		grid-template-rows: repeat(3, auto) 1fr;
		column-gap: clamp(1.25rem, 2.5vw, 2.5rem);
		align-items: start;
	}

	.panel--femke > :not(.panel__portrait) {
		grid-column: 2;
	}

	.panel__portrait {
		grid-area: 1 / 1 / -1 / 2;
		width: 100%;
		height: auto;
	}

	.panel--femke .panel__heading {
		padding-top: 0.4rem;
	}

	.panel--femke p ~ p {
		margin-top: 1.3em;
	}

	/* Skills: one row of tiles per topic. */
	.skillset + .skillset {
		margin-top: clamp(1.5rem, 2.2vw, 2rem);
	}

	.skillset__tools {
		--tool-size: clamp(2.6rem, 3.6vw, 3.25rem);
		display: flex;
		flex-wrap: wrap;
		gap: clamp(0.5rem, 0.8vw, 0.7rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Studies: per study its name with the years across from it, and the story underneath. */
	.studies {
		display: grid;
		gap: clamp(2rem, 3.6vw, 3.5rem);
		max-width: calc(100% - var(--strip-width) - 0.5vw);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.study {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: clamp(0.9rem, 1.6vw, 1.5rem) 1rem;
		align-items: baseline;
	}

	.study__name,
	.panel p.study__years {
		margin: 0;
		font-size: clamp(1rem, 1.25vw, 1.2rem);
		font-weight: 300;
		line-height: 1.2;
		letter-spacing: -0.04em;
	}

	.study__years {
		color: var(--color-accent);
		white-space: nowrap;
	}

	.study__text {
		grid-column: 1 / -1;
	}

	.study__text--note {
		margin-top: calc(-1 * clamp(0.3rem, 0.8vw, 0.8rem));
		color: var(--color-accent);
	}

	/* The strip hangs from the line under the tabs, between the studies and the name. */
	.panel__strip {
		position: absolute;
		top: -4.6vw;
		right: -1.5vw;
		width: var(--strip-width);
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.panel:not([hidden]) {
			animation: none;
		}
	}

	@media (max-width: 800px) {
		.about {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: 'title' 'main';
		}

		.about__title {
			position: static;
		}

		.about__main {
			margin-top: 1.5rem;
		}

		.about__main:has(.panel--studies:not([hidden])) .tabs {
			margin-right: 0;
		}

		/* One column, in reading order: the portrait sits between the first and second paragraph. */
		.panel--femke:not([hidden]) {
			display: block;
		}

		.panel__portrait {
			width: min(70%, 18rem);
			margin-block: 1.75rem 0.5rem;
		}

		/* No room beside the studies: the strip goes underneath them. */
		.studies {
			max-width: none;
		}

		/* Large, and hanging a little off the left edge of the screen, so its captions fit beside it. */
		.panel__strip {
			position: static;
			width: min(78vw, 24rem);
			margin: 1rem 0 0 -20vw;
		}
	}
</style>
