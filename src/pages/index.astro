---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import WordCloud from '../components/home/WordCloud.astro';
import WorkMarquee from '../components/home/WorkMarquee.astro';
import WhatIDo from '../components/home/WhatIDo.astro';
import SocialsInvite from '../components/SocialsInvite.astro';
---

<Layout>
	<Hero />
	<WordCloud />
	<WorkMarquee />
	<WhatIDo />
	<div class="socials">
		<SocialsInvite centered />
	</div>
</Layout>

<style>
	.socials {
		margin: 0 var(--gutter);
		padding-block: clamp(1rem, 2vw, 2rem) clamp(6rem, 13vw, 12rem);
	}
</style>
