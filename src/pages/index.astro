---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import WordCloud from '../components/home/WordCloud.astro';
---

<Layout>
	<Hero />
	<WordCloud />
	<!-- Open space, kept free for what comes here later. -->
	<div class="open-space" aria-hidden="true"></div>
</Layout>

<style>
	.open-space {
		height: clamp(14rem, 36vw, 34rem);
	}
</style>
