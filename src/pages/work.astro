---
import Layout from '../layouts/Layout.astro';
import SelectionFrame from '../components/SelectionFrame.astro';
import Star from '../components/Star.astro';
import ProjectRow from '../components/work/ProjectRow.astro';
import { projects } from '../data/projects';

// Positions from the Figma design: x as % of the page width, y in vw so they scale with it.
// The last two are measured from the bottom, so they stay below the list when a project opens.
const stars = [
	{ x: 48.5, y: 'top: 8vw', size: '1.4vw', variant: 'outline' },
	{ x: 17, y: 'top: 36.5vw', size: '3.4vw', variant: 'outline-alt', desktopOnly: true },
	{ x: 7, y: 'top: 68.5vw', size: '2.2vw', variant: 'filled', desktopOnly: true },
	{ x: 23.5, y: 'bottom: 6vw', size: '1.4vw', variant: 'outline' },
	{ x: 80.5, y: 'bottom: 2vw', size: '3.2vw', variant: 'outline-alt' },
] as const;
---

<Layout title="My Work — FDSGNS" description="Projects by Femke De Latter: visual design, creative coding, motion design and more.">
	<div class="work">
		{stars.map(({ x, y, size, variant, ...star }, i) => (
			<Star
				class:list={['work__star', { 'work__star--desktop': 'desktopOnly' in star }]}
				variant={variant}
				size={`max(${size}, 1rem)`}
				style={`left: ${x}%; ${y}; animation-delay: -${i * 1.4}s`}
			/>
		))}

		<h1 class="work__title">
			<SelectionFrame as="span" accent class="work__title-my">MY</SelectionFrame>
			<span>WORK</span>
		</h1>

		<div class="work__list">
			{projects.map((project) => <ProjectRow project={project} />)}
		</div>
	</div>
</Layout>

<script>
	const rows = [...document.querySelectorAll<HTMLDetailsElement>('.work__list details')];

	// Open the project in the URL (e.g. coming from a preview on the home page).
	const fromHash = rows.find((row) => `#${row.id}` === location.hash);
	if (fromHash) {
		fromHash.open = true;
		fromHash.scrollIntoView({ block: 'start' });
	}

	// Keep the URL in sync, so an open project can be shared or bookmarked.
	for (const row of rows) {
		row.addEventListener('toggle', () => {
			if (row.open) history.replaceState(null, '', `#${row.id}`);
			else if (location.hash === `#${row.id}`) history.replaceState(null, '', location.pathname);
		});
	}
</script>

<style>
	.work {
		--list-start: 30vw;
		position: relative;
		display: grid;
		/* minmax(0, …) stops the full-width gallery from stretching the list column. */
		grid-template-columns: var(--list-start) minmax(0, 1fr);
		align-items: start;
		padding: clamp(2rem, 5vw, 5rem) var(--gutter) clamp(6rem, 12vw, 10rem) 0;
	}

	.work :global(.work__star) {
		position: absolute;
		animation: bob 6s ease-in-out infinite alternate;
	}

	@keyframes bob {
		from { transform: translateY(-5px) rotate(-6deg); }
		to { transform: translateY(5px) rotate(6deg); }
	}

	.work__title {
		position: sticky;
		top: 2rem;
		display: grid;
		justify-items: start;
		gap: 0.1em;
		margin: 0;
		padding-left: calc(var(--gutter) + 1.5vw);
		color: var(--color-accent);
		font-size: clamp(3.5rem, 6.3vw, 6rem);
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.04em;
	}

	.work__title :global(.work__title-my) {
		--handle: 0.14em;
		padding: 0.1em 0.12em 0.02em;
	}

	.work__title > span:last-child {
		padding-left: 0.1em;
	}

	.work__list {
		position: relative;
		border-bottom: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.work :global(.work__star) {
			animation: none;
		}
	}

	@media (max-width: 800px) {
		.work {
			--list-start: var(--gutter);
			grid-template-columns: minmax(0, 1fr);
			row-gap: 3rem;
			padding-left: var(--gutter);
		}

		.work__title {
			position: static;
			padding-left: 0;
		}

		/* These sit on top of the list once it's full width. */
		.work :global(.work__star--desktop) {
			display: none;
		}
	}
</style>
