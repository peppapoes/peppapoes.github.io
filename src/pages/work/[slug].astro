---
/** A project's own page, built once for every project in src/data/projects.ts. */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SelectionFrame from '../../components/SelectionFrame.astro';
import Star from '../../components/Star.astro';
import ToolIcon from '../../components/work/ToolIcon.astro';
import ImageStrip from '../../components/work/ImageStrip.astro';
import { categoryLabels, projects, type Project } from '../../data/projects';

export const getStaticPaths = (() => projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props {
	project: Project;
}

const { project } = Astro.props;

// The framed media: the gallery, or else the preview image. A video goes to "End result".
const images = project.gallery?.length
	? project.gallery
	: project.preview
		? [{ src: project.preview, alt: project.previewAlt ?? '' }]
		: [];
const hasText = Boolean(project.assignment || project.idea?.length || project.tools?.length);

// Below the overview, every project page has the same tabs; each opens its topic
// underneath (and closes it again). Topics without content yet say so.
const tabs = [
	{ id: 'process', label: 'Process' },
	{ id: 'end-result', label: 'End result' },
];
// Panel ids differ from the URL hash (#process), so opening a tab from a link doesn't scroll the page.
const panelAttrs = (id: string) => ({ id: `panel-${id}`, 'aria-labelledby': `tab-${id}`, hidden: true });

const stars = [
	{ x: 47.5, y: 'top: 8rem', size: '1.4vw', variant: 'outline' },
	{ x: 80, y: 'top: 36vw', size: '2.6vw', variant: 'outline-alt' },
	{ x: 68, y: 'top: 58vw', size: '1.4vw', variant: 'outline' },
	{ x: 7, y: 'top: 64vw', size: '2vw', variant: 'filled' },
	{ x: 62, y: 'bottom: 1vw', size: '3vw', variant: 'outline-alt' },
] as const;
---

<Layout title={`${project.title} — FDSGNS`} description={project.assignment ?? `${project.title}, a ${categoryLabels[project.category].toLowerCase()} project by Femke De Latter.`}>
	<nav class="crumbs" aria-label="Breadcrumb">
		<ol>
			<li><a href="/work">My Work</a></li>
			<li><a href={`/work?filter=${project.category}`}>{categoryLabels[project.category]}</a></li>
			<li><span aria-current="page">{project.title}</span></li>
		</ol>
	</nav>

	<article class="project">
		{stars.map(({ x, y, size, variant }, i) => (
			<Star
				class="project__star"
				variant={variant}
				size={`max(${size}, 1rem)`}
				style={`left: ${x}%; ${y}; animation-delay: -${i * 1.4}s`}
			/>
		))}

		<section class="overview">
			<div class="project__main">
				<header class="project__heading">
					<p class="project__category">{categoryLabels[project.category].toLowerCase()}</p>
					<h1 class="project__title">{project.title}</h1>
				</header>

				{images.length > 0 && (
					<SelectionFrame class="project__media">
						{images.map(({ src, alt }) => (
							<Image src={src} alt={alt} widths={[600, 1000, 1400]} sizes="(max-width: 800px) 92vw, 45vw" />
						))}
					</SelectionFrame>
				)}
			</div>

			<div class="project__info">
				{project.assignment && (
					<section>
						<h2 class="project__label">Assignment</h2>
						<p>{project.assignment}</p>
					</section>
				)}

				{project.idea?.length ? (
					<section>
						<h2 class="project__label">Idea</h2>
						{project.idea.map((paragraph) => <p>{paragraph}</p>)}
					</section>
				) : null}

				{project.tools?.length ? (
					<section class="project__tools">
						<h2 class="project__label">Used tools</h2>
						<ul>
							{project.tools.map((tool) => <ToolIcon tool={tool} />)}
						</ul>
					</section>
				) : null}

				{!hasText && <p class="project__soon">more about this project coming soon!</p>}
			</div>
		</section>

		<div class="tabs">
			{tabs.map(({ id, label }) => (
				<button
					class="tabs__tab"
					id={`tab-${id}`}
					type="button"
					aria-expanded="false"
					aria-controls={`panel-${id}`}
					data-topic={id}
				>
					{label}
					<Star class="tabs__star tabs__star--closed" variant="outline" size="1em" />
					<Star class="tabs__star tabs__star--open" variant="filled" size="1em" />
				</button>
			))}
		</div>

		<section class="process" {...panelAttrs('process')}>
			{project.process?.length
				? project.process.map(({ title, text, images }) => (
						<section class="step">
							<h2 class="step__title">{title}</h2>
							{text && <p class="step__text">{text}</p>}
							<ImageStrip images={images} label={`${title} images`} />
						</section>
					))
				: <p class="project__soon">more coming soon!</p>}
		</section>

		<section class="result" {...panelAttrs('end-result')}>
			{project.video
				? <video
						class="result__video"
						src={`${project.video}#t=0.1`}
						controls
						playsinline
						preload="metadata"
						aria-label={`${project.title} video`}
					/>
				: <p class="project__soon">more coming soon!</p>}
		</section>
	</article>
</Layout>

<script>
	const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs [data-topic]')];

	// Opens one topic (closing the others), or closes everything with null.
	const show = (tab: HTMLButtonElement | null) => {
		for (const other of tabs) {
			const open = other === tab;
			other.setAttribute('aria-expanded', String(open));
			const panel = document.getElementById(other.getAttribute('aria-controls')!)!;
			panel.hidden = !open;
			if (!open) panel.querySelectorAll('video').forEach((video) => video.pause());
		}

		// Keep the open topic in the URL (e.g. /work/kickstarter#process) so it can be shared.
		history.replaceState(null, '', tab ? `#${tab.dataset.topic}` : location.pathname + location.search);
	};

	for (const tab of tabs) {
		tab.addEventListener('click', () => show(tab.getAttribute('aria-expanded') === 'true' ? null : tab));
	}

	const fromUrl = tabs.find((tab) => `#${tab.dataset.topic}` === location.hash);
	if (fromUrl) show(fromUrl);
</script>

<style>
	.crumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0 var(--gutter);
		padding: clamp(0.5rem, 1.5vw, 1.25rem) 0 1rem;
		list-style: none;
		font-size: clamp(0.85rem, 1.1vw, 1rem);
		letter-spacing: -0.03em;
	}

	.crumbs li + li::before {
		content: '/';
		margin-right: 0.4rem;
		opacity: 0.5;
	}

	.crumbs a {
		color: inherit;
		text-decoration: none;
		opacity: 0.7;
		transition: color 0.2s ease, opacity 0.2s ease;
	}

	.crumbs a:hover,
	.crumbs a:focus-visible {
		color: var(--color-accent);
		opacity: 1;
	}

	.crumbs [aria-current] {
		color: var(--color-accent);
	}

	.project {
		position: relative;
		margin: 0 var(--gutter);
		padding: clamp(1.5rem, 2.5vw, 2.5rem) 0 clamp(8rem, 16vw, 14rem);
		border-top: 1.5px solid var(--color-fg);
	}

	.project :global(.project__star) {
		position: absolute;
		animation: bob 6s ease-in-out infinite alternate;
	}

	@keyframes bob {
		from { transform: translateY(-5px) rotate(-6deg); }
		to { transform: translateY(5px) rotate(6deg); }
	}

	.project__heading {
		margin-bottom: clamp(2rem, 4vw, 3.5rem);
		padding-left: 0.4rem;
	}

	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem clamp(1.5rem, 3vw, 3rem);
		margin: clamp(3rem, 7vw, 6rem) 0 clamp(2rem, 4vw, 3.5rem);
		padding-left: 0.4rem;
	}

	.tabs__tab {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		padding: 0.25em 0;
		border: 0;
		background: none;
		color: var(--color-fg);
		font: inherit;
		font-size: clamp(1.1rem, 1.6vw, 1.5rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		cursor: pointer;
		transition: color 0.2s ease;
	}

	.tabs__tab:hover,
	.tabs__tab[aria-expanded='true'] {
		color: var(--color-accent);
	}

	.tabs__tab:focus-visible {
		outline: 1px solid var(--color-fg);
		outline-offset: 4px;
	}

	/* The star is the indicator: outlined while closed, pink and filled when open. */
	.tabs__tab :global(.tabs__star) {
		color: currentColor;
		transition: rotate 0.4s cubic-bezier(0.65, 0, 0.35, 1);
	}

	.tabs__tab :global(.tabs__star--open),
	.tabs__tab[aria-expanded='true'] :global(.tabs__star--closed) {
		display: none;
	}

	.tabs__tab[aria-expanded='true'] :global(.tabs__star--open) {
		display: block;
		color: var(--color-accent);
		rotate: 20deg;
	}

	.tabs__tab:hover :global(.tabs__star) {
		rotate: 20deg;
	}

	.process:not([hidden]),
	.result:not([hidden]) {
		animation: fade-in 0.4s ease;
	}

	@keyframes fade-in {
		from { opacity: 0; translate: 0 0.5rem; }
	}

	.overview {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		column-gap: clamp(2rem, 6vw, 7rem);
		align-items: start;
	}

	.process[hidden],
	.result[hidden] {
		display: none;
	}

	.project__category {
		margin: 0 0 0.2em;
		font-family: var(--font-hand);
		font-size: clamp(1.2rem, 1.9vw, 1.7rem);
	}

	.project__title {
		margin: 0;
		font-size: clamp(2.5rem, 4.6vw, 4.4rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.06em;
	}

	.project :global(.project__media) {
		--handle: 1.1rem;
		display: grid;
		gap: 0.6rem;
		max-width: min(44rem, calc((100svh - 18rem) * 1.48));
		padding: 0.9rem;
	}

	.project__media img {
		display: block;
		width: 100%;
		height: auto;
	}


	.step + .step {
		margin-top: clamp(2rem, 3.5vw, 3rem);
	}

	.step__title {
		margin: 0 0 1rem;
		padding-left: 0.4rem;
		font-family: var(--font-hand);
		font-size: 1rem;
		font-weight: 400;
	}

	.step__text {
		max-width: 44rem;
		margin: 0 0 1.5rem;
		padding-left: 0.4rem;
		font-size: clamp(1rem, 1.35vw, 1.3rem);
		font-weight: 300;
		line-height: 1.35;
		letter-spacing: -0.02em;
	}

	/* Never taller than the screen, so the page below stays in view. */
	.result__video {
		display: block;
		width: min(100%, 64rem, calc((100svh - 22rem) * 16 / 9));
		aspect-ratio: 16 / 9;
		background: #111;
	}

	.project__info {
		display: grid;
		gap: clamp(2.5rem, 4vw, 3.5rem);
		padding-top: 1.5rem;
	}

	.project__info section {
		display: grid;
		gap: 1rem;
	}

	.project__label {
		margin: 0;
		font-family: var(--font-hand);
		font-size: 1.1rem;
		font-weight: 400;
	}

	.project__info p {
		margin: 0;
		font-size: clamp(1rem, 1.35vw, 1.3rem);
		font-weight: 300;
		line-height: 1.35;
		letter-spacing: -0.02em;
	}

	.project__info section p + p {
		margin-top: 0.6em;
	}

	.project__tools {
		margin-top: clamp(1rem, 4vw, 4rem);
	}

	.project__tools ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project__soon {
		margin: 0;
		padding-left: 0.4rem;
	}

	.project__info .project__soon,
	.project__soon {
		font-family: var(--font-hand);
		font-size: clamp(1.2rem, 2vw, 1.6rem);
		font-weight: 400;
	}

	@media (prefers-reduced-motion: reduce) {
		.project :global(.project__star),
		.process:not([hidden]),
		.result:not([hidden]) {
			animation: none;
		}
	}

	@media (max-width: 800px) {
		.overview {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 2.5rem;
		}

		.project__info {
			padding-top: 0;
		}
	}
</style>
