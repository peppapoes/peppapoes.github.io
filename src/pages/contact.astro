---
import Layout from '../layouts/Layout.astro';
import SelectionFrame from '../components/SelectionFrame.astro';

const phone = '0477 57 82 13';
const email = 'fdelatter@gmail.com';

const socials = [
	{ label: 'Instagram', href: 'https://www.instagram.com/fdsgns/' },
	{ label: 'Behance', href: 'https://www.behance.net/femkedelatter' },
];
---

<Layout title="Contact — FDSGNS" description="Get in touch with Femke De Latter: by phone, by email or on social media.">
	<div class="contact">
		<h1 class="contact__title">
			<span>CONTACT</span>
			<SelectionFrame as="span" accent class="contact__title-me">ME</SelectionFrame>
		</h1>

		<div class="contact__info">
			<section>
				<h2 class="contact__label">Contact</h2>
				<p>
					See anything you like? Have some questions? Or just want to connect with me? Don’t hesitate to contact me!
				</p>
			</section>

			<section>
				<h2 class="contact__label">Phone</h2>
				<p><a href={`tel:+32${phone.replace(/\s/g, '').slice(1)}`}>{phone}</a></p>
			</section>

			<section>
				<h2 class="contact__label">Email</h2>
				<p><a href={`mailto:${email}`}>{email}</a></p>
			</section>
		</div>

		<div class="contact__socials">
			<p class="contact__more">Can’t get enough? My social media accounts are full of it too!</p>
			<ul>
				{socials.map(({ label, href }) => (
					<li><a class="contact__button" href={href} target="_blank" rel="noopener noreferrer">{label}</a></li>
				))}
			</ul>
		</div>
	</div>
</Layout>

<style>
	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: start;
		margin: 0 var(--gutter);
		padding: clamp(1.5rem, 3vw, 3rem) 0 clamp(6rem, 18vw, 16rem);
	}

	.contact__title {
		display: grid;
		justify-items: start;
		gap: 0.2em;
		margin: 0;
		padding-left: 4vw;
		color: var(--color-accent);
		font-size: clamp(3.5rem, 6.3vw, 6rem);
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.04em;
	}

	.contact__title > span:first-child {
		padding-left: 0.1em;
	}

	.contact__title :global(.contact__title-me) {
		--handle: 0.14em;
		padding: 0.1em 0.12em 0.02em;
		translate: -0.12em 0;
	}

	.contact__info {
		display: grid;
		gap: clamp(1.5rem, 2.6vw, 2.5rem);
		padding-top: clamp(0.5rem, 1.5vw, 1.5rem);
	}

	.contact__info section {
		display: grid;
		gap: clamp(0.5rem, 1vw, 0.9rem);
	}

	.contact__label {
		margin: 0;
		font-family: var(--font-hand);
		font-size: clamp(1.5rem, 2.1vw, 2rem);
		font-weight: 400;
		letter-spacing: 0.02em;
	}

	.contact__info p {
		max-width: 40rem;
		margin: 0;
		font-size: clamp(1rem, 1.35vw, 1.3rem);
		font-weight: 300;
		line-height: 1.3;
		letter-spacing: -0.03em;
	}

	.contact__info a {
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.contact__info a:hover,
	.contact__info a:focus-visible {
		color: var(--color-accent);
	}

	/* Below the line: an invitation and a button per social account. */
	.contact__socials {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem 2rem;
		margin-top: clamp(2rem, 3.5vw, 3.5rem);
		padding-top: clamp(1.5rem, 2.4vw, 2.25rem);
		border-top: 1.5px solid var(--color-fg);
	}

	.contact__more {
		margin: 0;
		font-family: var(--font-hand);
		font-size: clamp(1.15rem, 1.6vw, 1.5rem);
		letter-spacing: 0.02em;
	}

	.contact__socials ul {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(0.75rem, 1.7vw, 1.6rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.contact__button {
		display: grid;
		place-items: center;
		min-width: clamp(9rem, 17vw, 16rem);
		padding: 0.85em 1.5em 0.75em;
		border: 1.5px solid var(--color-fg);
		font-size: clamp(1rem, 1.6vw, 1.5rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		text-decoration: none;
		text-transform: uppercase;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}

	.contact__button:hover,
	.contact__button:focus-visible {
		border-color: var(--color-accent);
		background: var(--color-accent);
		color: var(--color-bg);
		outline: none;
	}

	@media (max-width: 800px) {
		.contact {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 3rem;
		}

		.contact__title {
			padding-left: 0.12em;
		}

		.contact__socials {
			margin-top: 0;
		}

		.contact__socials ul,
		.contact__socials li {
			flex: 1 1 auto;
		}

		.contact__button {
			min-width: 0;
		}
	}
</style>
