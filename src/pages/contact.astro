---
import Layout from '../layouts/Layout.astro';
import SelectionFrame from '../components/SelectionFrame.astro';
import SocialsInvite from '../components/SocialsInvite.astro';

const phone = '0477 57 82 13';
const email = 'fdelatter@gmail.com';
---

<Layout title="Contact — FDSGNS" description="Get in touch with Femke De Latter: by phone, by email or on social media.">
	<div class="contact">
		<h1 class="contact__title">
			<span>CONTACT</span>
			<SelectionFrame as="span" accent class="contact__title-me">ME</SelectionFrame>
		</h1>

		<div class="contact__info">
			<section>
				<h2 class="contact__label">Contact</h2>
				<p>
					See anything you like? Have some questions? Or just want to connect with me? Don’t hesitate to contact me!
				</p>
			</section>

			<section>
				<h2 class="contact__label">Phone</h2>
				<p><a href={`tel:+32${phone.replace(/\s/g, '').slice(1)}`}>{phone}</a></p>
			</section>

			<section>
				<h2 class="contact__label">Email</h2>
				<p><a href={`mailto:${email}`}>{email}</a></p>
			</section>
		</div>

		<div class="contact__socials">
			<SocialsInvite />
		</div>
	</div>
</Layout>

<style>
	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: start;
		margin: 0 var(--gutter);
		padding: clamp(1.5rem, 3vw, 3rem) 0 clamp(6rem, 18vw, 16rem);
	}

	.contact__title {
		display: grid;
		justify-items: start;
		gap: 0.2em;
		margin: 0;
		padding-left: 4vw;
		color: var(--color-accent);
		font-size: clamp(3.5rem, 6.3vw, 6rem);
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.04em;
	}

	.contact__title > span:first-child {
		padding-left: 0.1em;
	}

	.contact__title :global(.contact__title-me) {
		--handle: 0.14em;
		padding: 0.1em 0.12em 0.02em;
		translate: -0.12em 0;
	}

	.contact__info {
		display: grid;
		gap: clamp(1.5rem, 2.6vw, 2.5rem);
		padding-top: clamp(0.5rem, 1.5vw, 1.5rem);
	}

	.contact__info section {
		display: grid;
		gap: var(--subtitle-gap);
	}

	.contact__label {
		margin: 0;
		font-family: var(--font-hand);
		font-size: var(--text-subtitle);
		font-weight: 400;
		letter-spacing: 0.02em;
	}

	.contact__info p {
		max-width: 40rem;
		margin: 0;
		font-size: var(--text-body);
		font-weight: 300;
		line-height: 1.35;
		letter-spacing: -0.02em;
	}

	.contact__info a {
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.contact__info a:hover,
	.contact__info a:focus-visible {
		color: var(--color-accent);
	}

	/* Below the line: the invitation to her social media. */
	.contact__socials {
		grid-column: 1 / -1;
		margin-top: clamp(2rem, 3.5vw, 3.5rem);
		padding-top: clamp(1.5rem, 2.4vw, 2.25rem);
		border-top: 1.5px solid var(--color-fg);
	}

	@media (max-width: 800px) {
		.contact {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 3rem;
		}

		.contact__title {
			padding-left: 0.12em;
		}

		.contact__socials {
			margin-top: 0;
		}
	}
</style>
