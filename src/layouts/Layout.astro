---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Starfield from '../components/Starfield.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Femke De Latter — FDSGNS',
	description = 'Portfolio van Femke De Latter: visual design, motion design, coding & development.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<!-- The card shown when the link is shared (public/og.png, 1200 × 630). -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="FDSGNS" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:image" content={new URL('/og.png', Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="My portfolio by FDSGNS — portfolio website 2026" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Gochi+Hand&family=Jost:wght@300;400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<Starfield count={160} seed={7} fixed />
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #000;
		--color-fg: #fff;
		--color-accent: #f26671;

		/* Futura is the design font; Jost is the closest free alternative. */
		--font-sans: 'Futura PT', 'Futura', 'Jost', system-ui, sans-serif;
		/* Minute is the handwritten design font; Gochi Hand stands in where it isn't installed. */
		--font-hand: 'Minute', 'Gochi Hand', 'Comic Sans MS', cursive;

		--gutter: clamp(1rem, 3vw, 2.5rem);

		/* Shared text styles, the same on every page: running text (about 16px), the
		   handwritten subtitles, and the small break between a subtitle and its text. */
		--text-body: clamp(1rem, 1.1vw, 1.125rem);
		--text-subtitle: clamp(1.3rem, 1.6vw, 1.55rem);
		--subtitle-gap: clamp(0.6rem, 1vw, 0.9rem);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		background: var(--color-bg);
		color: var(--color-fg);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
	}

	body {
		margin: 0;
		overflow-x: hidden;
	}

	img {
		display: block;
		max-width: 100%;
	}

	a {
		color: inherit;
	}
</style>
